CBZ_PROOF {"axioms":["propext","Classical.choice","Quot.sound"],"declaration":"ResearchFormalCoreR1.d2_tau_diagonal","module":"ResearchFormalCoreR1.D2Schur","prop_premise_binders":[],"statement":"∀ (m2 m4 m6 : ℝ),\n  ResearchFormalCoreR1.d2Tau m2 m4 m6 (1 / 4) = (ResearchFormalCoreR1.d2Delta m2 m4 m6 + 9 * m2 * (m4 - m2 ^ 2)) / 4"}
