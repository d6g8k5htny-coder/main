{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-law:formal-certificate:v17",
  "title": "Quarantined formal certificate candidate v17",
  "description": "Schema conformance is necessary metadata validation only. No reviewed kernel adapter or trusted formal statement alignment exists in v17, so candidates remain blocked or rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_id", "record_id", "obligation_id", "bindings", "assumptions", "formal_statement", "proof_artifact", "checker", "alignment", "claimed_independent_reproduction"],
  "properties": {
    "schema_version": {"const": "UL-formal-certificate-v17.0"},
    "certificate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "record_id": {"type": "string", "minLength": 1},
    "obligation_id": {"type": "string", "pattern": "^OBL:.+"},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_sha256", "statement_sha256", "obligation_fingerprint", "premise_fingerprints", "side_conditions_sha256", "import_fingerprints", "correction_fingerprints", "local_evidence_fingerprints", "source_mapping_sha256"],
      "properties": {
        "dataset_sha256": {"$ref": "#/$defs/sha256", "description": "Full working dataset at candidate creation, retained as audit context. Applicability uses exact recursive obligation and requirement fingerprints, allowing unrelated branch changes."},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "obligation_fingerprint": {"$ref": "#/$defs/sha256"},
        "premise_fingerprints": {"$ref": "#/$defs/fingerprint_map"},
        "side_conditions_sha256": {"$ref": "#/$defs/sha256"},
        "import_fingerprints": {"$ref": "#/$defs/fingerprint_map"},
        "correction_fingerprints": {"$ref": "#/$defs/fingerprint_map"},
        "local_evidence_fingerprints": {"$ref": "#/$defs/fingerprint_map"},
        "source_mapping_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assumptions": {
      "type": "object", "additionalProperties": false,
      "required": ["premises", "side_conditions", "external_theorem_imports", "source_corrections", "unlisted_side_conditions_possible"],
      "properties": {
        "premises": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "side_conditions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "external_theorem_imports": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_corrections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unlisted_side_conditions_possible": {"type": "boolean"}
      }
    },
    "formal_statement": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "language", "theorem_name"],
      "properties": {
        "file": {"$ref": "#/$defs/artifact"},
        "language": {"enum": ["lean4", "coq"]},
        "theorem_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.']{0,199}$"}
      }
    },
    "proof_artifact": {"$ref": "#/$defs/artifact"},
    "checker": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "binary_sha256", "environment_sha256"],
      "properties": {
        "id": {"enum": ["lean-kernel", "coq-kernel"]},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "alignment": {
      "type": "object", "additionalProperties": false,
      "required": ["curated_statement_sha256", "formal_statement_sha256", "assumptions_sha256"],
      "properties": {
        "curated_statement_sha256": {"$ref": "#/$defs/sha256"},
        "formal_statement_sha256": {"$ref": "#/$defs/sha256"},
        "assumptions_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claimed_independent_reproduction": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "Confined relative path with no symlink components; enforced by the Python gate."},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}
      }
    }
  }
}
