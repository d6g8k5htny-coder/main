'TorusRegularSuperlevel.closed_superlevel_regular_basis' depends on axioms: [propext, Classical.choice, Quot.sound]
'TorusRegularSuperlevel.closed_superlevel_path_connected_basis' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'TorusRegularSuperlevel.closed_superlevel_interior_basis' depends on axioms: [propext, Classical.choice, Quot.sound]
@TorusRegularSuperlevel.closed_superlevel_regular_basis : ∀ {d : ℕ} {g : UniversalLaw.Spec.Lifetime.E d → ℝ},
  UniversalLaw.Spec.Lifetime.IsSmooth d g →
    ∀ (a : ℝ) (x : { y // a ≤ g y }),
      ¬UniversalLaw.Spec.Lifetime.IsCriticalPoint d g ↑x →
        (nhds x).HasBasis (fun V => V ∈ nhds x ∧ IsPathConnected V) id
@TorusRegularSuperlevel.closed_superlevel_path_connected_basis : ∀ {d : ℕ} {g : UniversalLaw.Spec.Lifetime.E d → ℝ},
  UniversalLaw.Spec.Lifetime.IsSmooth d g →
    ∀ (a : ℝ) (x : { y // a ≤ g y }),
      a < g ↑x ∨ ¬UniversalLaw.Spec.Lifetime.IsCriticalPoint d g ↑x →
        (nhds x).HasBasis (fun V => V ∈ nhds x ∧ IsPathConnected V) id
@TorusRegularSuperlevel.closed_superlevel_interior_basis : ∀ {d : ℕ} {g : UniversalLaw.Spec.Lifetime.E d → ℝ},
  Continuous g →
    ∀ (a : ℝ) (x : { y // a ≤ g y }), a < g ↑x → (nhds x).HasBasis (fun V => V ∈ nhds x ∧ IsPathConnected V) id
