      {x : X},
      @Membership.mem X (Set X) (@Set.instMembership X) U x →
        @Filter.HasBasis X (Set X) (@nhds X inst x)
          (fun V =>
            And (@Membership.mem (Set X) (Filter X) (@Filter.instMembership X) (@nhds X inst x) V)
              (@IsPathConnected X inst V))
          (@id (Set X))
