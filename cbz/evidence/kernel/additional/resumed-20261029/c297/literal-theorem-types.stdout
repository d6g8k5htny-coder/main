  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] [@LocallyPathConnectedSpace X inst] {e : X → Y},
  @Topology.IsOpenEmbedding X Y inst inst_1 e →
    ∀ (x : X),
      @Filter.HasBasis Y (Set Y) (@nhds Y inst_1 (e x))
        (fun V =>
          And (@Membership.mem (Set Y) (Filter Y) (@Filter.instMembership Y) (@nhds Y inst_1 (e x)) V)
            (@IsPathConnected Y inst_1 V))
        (@id (Set Y))
@TorusRegularSuperlevel.path_connected_basis_of_open : ∀ {X : Type u_1} [inst : TopologicalSpace X] {U : Set X},
  @IsOpen X inst U →
