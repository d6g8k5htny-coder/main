+    def test_sync_lazy_returns_refuse_without_advancing_suspended_work(self):
+        definitions = '''
+            def generator():
+                record('generator advanced')
+                yield None
+            async def coroutine(): record('coroutine advanced')
+            async def async_generator():
+                record('async generator advanced')
+                yield None
+            class Awaitable:
+                def __await__(self):
