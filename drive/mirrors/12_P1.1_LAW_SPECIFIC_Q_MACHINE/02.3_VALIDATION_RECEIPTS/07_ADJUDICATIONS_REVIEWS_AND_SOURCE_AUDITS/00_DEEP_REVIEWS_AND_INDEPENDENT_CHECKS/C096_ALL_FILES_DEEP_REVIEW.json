  "authority_decision": {
    "conceptual_master": "GATE_FRAMEWORK_MASTER_v1_2_RECONCILED.md",
    "executable_kernel": "gate_kernel_v2_0.py",
    "legacy_registry": "q0 registry.json is a demonstration, not Q0 theorem authority",
    "migrated_registry": "q0_registry_v2_0.json, archive-only until its open gates close",
    "pdf": "v1.0 provenance; a clean v1.2 PDF should replace it in a future release"
  },
  "conceptual_findings": [
    {
      "id": "DOC-01",
      "grade": "ESTABLISHED-FROM-TEXT",
      "finding": "The uploaded v1.1's shell/core split is the strongest conceptual advance in the file set: gates type-check declarations, while proofs and adversarial verification establish fidelity.",
      "decision": "Retained verbatim in substance in Master v1.2."
    },
    {
      "id": "DOC-02",
      "grade": "ESTABLISHED-FROM-TEXT",
      "finding": "Promoting changes of measure, mark transfers, model transfers, and composition witnesses to graded graph nodes closes the largest free-text escape hatch in v1.0.",
      "decision": "Retained and made source/target typed in Kernel 2.0."
    },
    {
      "id": "DOC-03",
      "grade": "DERIVED-AUDIT",
      "finding": "The v1.1 dependability account still permits condition laundering: Primitive and Proven-Modulo are called fully dependable without a machine rule requiring unresolved conditions to propagate.",
      "decision": "Master v1.2 and Kernel 2.0 propagate complete condition sets."
    },
    {
      "id": "DOC-04",
      "grade": "DERIVED-AUDIT",
      "finding": "COMMON-MODE's provisional ceiling as 'the current grade' is a no-op when a claim has already been overgraded.",
      "decision": "The default cap is now Derived."
    },
    {
      "id": "DOC-05",
      "grade": "DERIVED-AUDIT",
      "finding": "The v1.1 witness lexicon still omits UNION_BOUND while its examples invoke a union bound and unnecessarily mention disjointness.",
      "decision": "Operation-specific witness types are mandatory in v1.2/Kernel 2.0."
    },
    {
      "id": "DOC-06",
      "grade": "CERTIFIED-RETRODICTION",
      "finding": "ASSEMBLY, numerical UNIFORMITY, and BAND-PROVENANCE now have enough frozen failure evidence to be established gates.",
      "decision": "Promoted as Gates 14\u201316."
    },
    {
      "id": "DOC-07",
      "grade": "DERIVED-AUDIT",
      "finding": "F-1 records establishment but not deployment in the uploaded v1.1, so a machine lacks the second regime needed for an actual transfer test.",
      "decision": "F-1 is now an establishment/deployment pair."
    },
    {
      "id": "DOC-08",
      "grade": "DERIVED-AUDIT",
      "finding": "The content-hash discipline is conceptually active but the file does not define canonical serialization.",
      "decision": "Master v1.2 and Kernel 2.0 define canonical JSON SHA-256."
    },
    {
      "id": "DOC-09",
      "grade": "PROVISIONAL-META-EVIDENCE",
      "finding": "COMMON-MODE and HEURISTIC-BRIDGE are useful operational gates, but their claimed two-case retrodiction evidence is not identified by frozen IDs and hashes in the uploaded package.",
      "decision": "Operationally enforced; framework-level retrodiction claim remains provisional."
    }
  ],
