"""LS-DATA-043A: high-precision side-24 short-lifetime coefficient.

Implements the exact one-dimensional angular reduction of the contact-limit
coefficient for the normalized periodized Bargmann-Fock covariance.
No Monte Carlo sampling is used.
"""
from __future__ import annotations

import json
import hashlib
from pathlib import Path
import mpmath as mp

DPS = 220
L = mp.mpf(24)
IMAGE_N = 4  # |n|>=2 is already exp(-1152) at L=24.
mp.mp.dps = DPS


def hermite_prob(n: int, x: mp.mpf) -> mp.mpf:
    if n == 0:
        return mp.mpf(1)
    if n == 1:
        return x
    hm2, hm1 = mp.mpf(1), x
    for k in range(1, n):
        hm2, hm1 = hm1, x * hm1 - k * hm2
    return hm1


def periodized_moments(L: mp.mpf, max_order: int = 6) -> dict[int, mp.mpf]:
    denominator = mp.mpf(0)
    numerators = {j: mp.mpf(0) for j in range(max_order + 1)}
    for n in range(-IMAGE_N, IMAGE_N + 1):
        z = n * L
        weight = mp.exp(-z * z / 2)
        denominator += weight
        for j in range(max_order + 1):
            numerators[j] += ((-1) ** j) * hermite_prob(j, z) * weight
    return {j: numerators[j] / denominator for j in numerators}


def planar_moments() -> dict[int, mp.mpf]:
    return {0: mp.mpf(1), 1: mp.mpf(0), 2: mp.mpf(-1), 3: mp.mpf(0),
            4: mp.mpf(3), 5: mp.mpf(0), 6: mp.mpf(-15)}


def operator_coefficients(a: int, b: int, theta: mp.mpf) -> dict[tuple[int, int], mp.mpf]:
    """Coefficients of D_t^a D_s^b in Cartesian derivatives."""
    c, s = mp.cos(theta), mp.sin(theta)
    poly: dict[tuple[int, int], mp.mpf] = {(0, 0): mp.mpf(1)}
    for _ in range(a):
        nxt: dict[tuple[int, int], mp.mpf] = {}
        for (i, j), value in poly.items():
            nxt[(i + 1, j)] = nxt.get((i + 1, j), mp.mpf(0)) + c * value
            nxt[(i, j + 1)] = nxt.get((i, j + 1), mp.mpf(0)) + s * value
        poly = nxt
    for _ in range(b):
        nxt = {}
        for (i, j), value in poly.items():
            nxt[(i + 1, j)] = nxt.get((i + 1, j), mp.mpf(0)) - s * value
            nxt[(i, j + 1)] = nxt.get((i, j + 1), mp.mpf(0)) + c * value
        poly = nxt
    return poly


def derivative_covariance(op1, op2, moments: dict[int, mp.mpf]) -> mp.mpf:
    degree2 = next(iter({sum(key) for key in op2}))
    value = mp.mpf(0)
    for (i, j), a in op1.items():
        for (k, l), b in op2.items():
            value += a * b * moments[i + k] * moments[j + l]
    return ((-1) ** degree2) * value


def angular_parameters(theta: mp.mpf, moments: dict[int, mp.mpf]):
    # Y=(f,-f_ttt/12,f_t,f_tt,f_s,f_ts), q=f_ss.
    derivative_types = [(0, 0), (3, 0), (1, 0), (2, 0), (0, 1), (1, 1)]
    scales = [mp.mpf(1), -mp.mpf(1) / 12, mp.mpf(1), mp.mpf(1), mp.mpf(1), mp.mpf(1)]
    operators = [operator_coefficients(a, b, theta) for a, b in derivative_types]
    sigma = mp.matrix(6, 6)
    for i in range(6):
        for j in range(6):
            sigma[i, j] = scales[i] * scales[j] * derivative_covariance(
                operators[i], operators[j], moments
            )
    q_op = operator_coefficients(0, 2, theta)
    cov_qy = mp.matrix(1, 6)
    for j in range(6):
        cov_qy[0, j] = scales[j] * derivative_covariance(q_op, operators[j], moments)
    var_q = derivative_covariance(q_op, q_op, moments)
    inv = sigma ** -1
    e_b = mp.matrix([1, 0, 0, 0, 0, 0])
    e_k = mp.matrix([0, -mp.mpf(1) / 6, 0, 0, 0, 0])
    A = (e_b.T * inv * e_b)[0] / 2
    B = (e_k.T * inv * e_k)[0] / 2
    cross = (e_b.T * inv * e_k)[0]
    mean_b = (cov_qy * inv * e_b)[0]
    mean_k = (cov_qy * inv * e_k)[0]
    conditional_var = var_q - (cov_qy * inv * cov_qy.T)[0]
    pin_norm = (2 * mp.pi) ** (-3) / mp.sqrt(mp.det(sigma))
    return A, B, cross, mean_b, mean_k, conditional_var, pin_norm


ALPHA = mp.power(6, mp.mpf(2) / 3) / 3
GAMMA_76 = mp.gamma(mp.mpf(7) / 6)


def angular_coefficient(theta: mp.mpf, moments: dict[int, mp.mpf]) -> mp.mpf:
    A, B, cross, mean_b, mean_k, conditional_var, pin_norm = angular_parameters(theta, moments)
    # Exact parity gives cross=mean_k=0. Fail closed if numerical residue is non-negligible.
    if abs(cross) > mp.mpf('1e-180') or abs(mean_k) > mp.mpf('1e-180'):
        raise RuntimeError(f"Parity block failure: cross={cross}, mean_k={mean_k}")
    birth_integral = mp.sqrt(mp.pi / A) * mp.mpf('0.5') * (
        conditional_var + mean_b * mean_b / (2 * A)
    )
    kappa_integral = mp.mpf('0.5') * B ** (-mp.mpf(7) / 6) * GAMMA_76
    return ALPHA * pin_norm * birth_integral * kappa_integral / 6


def coefficient(moments: dict[int, mp.mpf]) -> mp.mpf:
    # Square symmetry: 8 times the integral over [0, pi/4].
    return 8 * mp.quad(lambda theta: angular_coefficient(theta, moments), [0, mp.pi / 4])


def s(x: mp.mpf, digits: int = 180) -> str:
    return mp.nstr(x, digits)


m_planar = planar_moments()
m_24 = periodized_moments(L)
c_planar_quadrature = coefficient(m_planar)
c_planar_closed = (
    mp.power(2, mp.mpf(2) / 3)
    * mp.power(3, mp.mpf(5) / 6)
    * mp.gamma(mp.mpf(1) / 6)
    / (54 * mp.power(mp.pi, mp.mpf(3) / 2))
)
c_24 = coefficient(m_24)
difference = c_24 - c_planar_closed
relative_difference = difference / c_planar_closed

symmetry_points = [mp.pi / 31, mp.pi / 17, mp.pi / 11]
symmetry_errors = [
    abs(angular_coefficient(t, m_24) - angular_coefficient(mp.pi / 2 - t, m_24))
    for t in symmetry_points
]

result = {
    "artifact_id": "LS-DATA-043B-v1.0",
    "dps": DPS,
    "torus_side": "24",
    "image_cutoff": IMAGE_N,
    "periodized_even_derivatives": {
        str(j): s(m_24[j], 190) for j in [0, 2, 4, 6]
    },
    "moment_corrections_from_planar": {
        "k2_plus_1": s(m_24[2] + 1, 190),
        "k4_minus_3": s(m_24[4] - 3, 190),
        "k6_plus_15": s(m_24[6] + 15, 190),
    },
    "c_planar_closed": s(c_planar_closed, 190),
    "c_planar_quadrature": s(c_planar_quadrature, 190),
    "planar_internal_error": s(c_planar_quadrature - c_planar_closed, 190),
    "c_24_specific": s(c_24, 190),
    "c_24_total_576x": s(576 * c_24, 190),
    "c_24_minus_c_infinity": s(difference, 190),
    "relative_correction": s(relative_difference, 190),
    "square_symmetry_errors": [s(x, 80) for x in symmetry_errors],
    "interpretation": "High-precision deterministic candidate; not a certified interval proof.",
}

output_path = Path('/mnt/data/ls_data_043b_side24_coefficient_result.json.txt')
output_path.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
source_path = Path(__file__) if '__file__' in globals() else Path('/mnt/data/ls_data_043a_side24_coefficient.py.txt')
result["source_sha256"] = hashlib.sha256(Path('/mnt/data/ls_data_043a_side24_coefficient.py.txt').read_bytes()).hexdigest()
result["result_sha256_before_self_field"] = hashlib.sha256(output_path.read_bytes()).hexdigest()
output_path.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
print(json.dumps(result, indent=2))
