"""LS-DATA-045A: symbolic first variation of the finite-L BF coefficient.

Derives the angularly averaged sensitivities of the exact finite-L coefficient
with respect to the even one-dimensional covariance moments m2,m4,m6 at the
planar Bargmann-Fock point, then inserts the leading periodization-image
corrections.
"""
from __future__ import annotations
import json, hashlib
from pathlib import Path
import sympy as sp

th = sp.symbols('theta', real=True)
c, s = sp.cos(th), sp.sin(th)
m2, m4, m6, L = sp.symbols('m2 m4 m6 L', real=True)
mom = {0:sp.Integer(1),1:0,2:m2,3:0,4:m4,5:0,6:m6}

def op_coeff(a:int,b:int):
    poly={(0,0):sp.Integer(1)}
    for _ in range(a):
        nxt={}
        for (i,j),v in poly.items():
            nxt[(i+1,j)] = nxt.get((i+1,j),0)+c*v
            nxt[(i,j+1)] = nxt.get((i,j+1),0)+s*v
        poly=nxt
    for _ in range(b):
        nxt={}
        for (i,j),v in poly.items():
            nxt[(i+1,j)] = nxt.get((i+1,j),0)-s*v
            nxt[(i,j+1)] = nxt.get((i,j+1),0)+c*v
        poly=nxt
    return poly

def dcov(op1,op2):
    degrees={sum(k) for k in op2}
    assert len(degrees)==1
    degree2=next(iter(degrees))
    value=0
    for (i,j),a in op1.items():
        for (k,l),b in op2.items():
            value += a*b*mom[i+k]*mom[j+l]
    return sp.simplify((-1)**degree2*value)

types=[(0,0),(3,0),(1,0),(2,0),(0,1),(1,1)]
scales=[1,sp.Rational(-1,12),1,1,1,1]
ops=[op_coeff(*x) for x in types]
Sigma=sp.Matrix(6,6,lambda i,j: sp.expand(scales[i]*scales[j]*dcov(ops[i],ops[j])))
qop=op_coeff(0,2)
v=sp.Matrix([[sp.expand(scales[j]*dcov(qop,ops[j])) for j in range(6)]])
tau=sp.expand(dcov(qop,qop))
subs0={m2:-1,m4:3,m6:-15}
S0=sp.simplify(Sigma.subs(subs0)); Sinv=S0.inv()
v0=sp.simplify(v.subs(subs0)); tau0=sp.simplify(tau.subs(subs0))
eb=sp.Matrix([1,0,0,0,0,0]); ek=sp.Matrix([0,sp.Rational(-1,6),0,0,0,0])
A0=sp.simplify((eb.T*Sinv*eb)[0]/2)
B0=sp.simplify((ek.T*Sinv*ek)[0]/2)
mu0=sp.simplify((v0*Sinv*eb)[0])
sig0=sp.simplify(tau0-(v0*Sinv*v0.T)[0])
V0=sp.simplify(sig0+mu0**2/(2*A0))

sens={}
for mm in (m2,m4,m6):
    dS=Sigma.diff(mm).subs(subs0); dv=v.diff(mm).subs(subs0); dt=tau.diff(mm).subs(subs0)
    dA=sp.simplify(-sp.Rational(1,2)*(eb.T*Sinv*dS*Sinv*eb)[0])
    dB=sp.simplify(-sp.Rational(1,2)*(ek.T*Sinv*dS*Sinv*ek)[0])
    dmu=sp.simplify((dv*Sinv*eb)[0]-(v0*Sinv*dS*Sinv*eb)[0])
    dsig=sp.simplify(dt-2*(dv*Sinv*v0.T)[0]+(v0*Sinv*dS*Sinv*v0.T)[0])
    dlogN=sp.simplify(-sp.Rational(1,2)*sp.trace(Sinv*dS))
    dV=sp.simplify(dsig+mu0*dmu/A0-mu0**2*dA/(2*A0**2))
    dlogF=sp.trigsimp(dlogN-sp.Rational(1,2)*dA/A0+dV/V0-sp.Rational(7,6)*dB/B0)
    avg=sp.simplify(sp.integrate(dlogF,(th,0,2*sp.pi))/(2*sp.pi))
    sens[str(mm)]={'dlogF_theta':str(dlogF),'angular_average':str(avg)}

lead_dm2=2*L**2
lead_dm4=2*(L**4-6*L**2)
lead_dm6=2*(L**6-15*L**4+45*L**2)
relative_poly=sp.factor(sp.Rational(3,8)*lead_dm2-sp.Rational(7,24)*lead_dm4-sp.Rational(5,72)*lead_dm6)

cinf=sp.Pow(2,sp.Rational(2,3))*sp.Pow(3,sp.Rational(5,6))*sp.gamma(sp.Rational(1,6))/(54*sp.pi**sp.Rational(3,2))
lead_rel_24=sp.N(relative_poly.subs(L,24)*sp.exp(-sp.Rational(24**2,2)),100)
lead_abs_24=sp.N(cinf*relative_poly.subs(L,24)*sp.exp(-sp.Rational(24**2,2)),100)

result={
 'artifact_id':'LS-DATA-045B-v1.0',
 'planar_parameters':{'A':str(A0),'B':str(B0),'mu':str(mu0),'sigma2':str(sig0),'V':str(V0)},
 'angular_sensitivities':sens,
 'leading_moment_corrections_divided_by_q':{
     'dm2':str(lead_dm2),'dm4':str(lead_dm4),'dm6':str(lead_dm6)},
 'relative_correction_polynomial':str(relative_poly),
 'asymptotic':'(c_L-c_inf)/c_inf = P(L)*exp(-L^2/2)+O(L^12 exp(-L^2))',
 'leading_relative_L24':str(lead_rel_24),
 'leading_absolute_L24':str(lead_abs_24),
}
source=Path('/mnt/data/ls_data_045a_periodization_asymptotic.py.txt')
result['source_sha256']=hashlib.sha256(source.read_bytes()).hexdigest()
out=Path('/mnt/data/ls_data_045b_periodization_asymptotic_result.json.txt')
out.write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
result['result_sha256_before_self_field']=hashlib.sha256(out.read_bytes()).hexdigest()
out.write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
print(json.dumps(result,indent=2))
