# AO48 mid-tier structural scan (uses unmodified W3 certified evaluators).
# Output: x y mid_hi cheap_hi pgrad_hi Pwin_hi mt_mid  (mid = certified UPPER on rho at the point)
import math, sys, time
from mpmath import iv, mpi
import mpmath as mp
iv.prec = 350
import importlib.util
spec = importlib.util.spec_from_file_location("w3c", "/mnt/agents/output/K3_SIDE24_LB/W3_numerics/w3_cert.py")
w3c = importlib.util.module_from_spec(spec)
spec.loader.exec_module(w3c)
lo, hi, mid = w3c.lo, w3c.hi, w3c.mid
w3c.init_caches()
G = w3c.gram_interval()
C, Es = w3c.build_whitener(G)
law = w3c.build_law(G, C)
mu_t = w3c.compute_mu_t(G)
tv = w3c.matvec_iv(law['C'], w3c.pin_values(mu_t))
iv.prec = 160
x0, x1, y0, y1, sz = map(float, sys.argv[1:6])
out = open(sys.argv[6], "w", buffering=1)
PINS = [(-0.0125,0.0),(0.0125,0.0),(-0.0315,0.006)]
nx = int(round((x1-x0)/sz)); ny = int(round((y1-y0)/sz))
t0 = time.time(); n = 0
for i in range(nx):
    for j in range(ny):
        xc = x0 + (i+0.5)*sz; yc = y0 + (j+0.5)*sz
        if min((xc-px)**2+(yc-py)**2 for (px,py) in PINS) < 1e-8: continue
        yb = (mpi(xc,xc), mpi(yc,yc))
        try:
            r = w3c.rho_box(yb, law, tv, 1e-4, "scan", need_exact=False)
            m_hi = float(hi(r.get('mid', r['cheap'])))
            c_hi = float(hi(r['cheap']))
            out.write("%.4f %.4f %.6e %.6e %.4e %.4e %.6f\n" % (xc, yc, m_hi, c_hi,
                float(hi(r['pgrad'])), float(hi(r['Pwin'])), float(mid(r['mt']))))
        except SystemExit:
            out.write("%.4f %.4f KILLED\n" % (xc, yc))
        n += 1
    print("row %d/%d n=%d t=%.0fs" % (i+1, nx, n, time.time()-t0), flush=True)
out.close()
print("DONE n=%d t=%.0fs" % (n, time.time()-t0))

