    res["sub"] = bool((aiv - biv).lo == -3 and (aiv - biv).hi == -1)
    m = aiv * I(-1, 3)
    res["mul"] = bool(m.lo == -2 and m.hi == 6)
    d = aiv / I(2, 4)
    res["div"] = bool(d.lo == Q(1, 4) and d.hi == 1)

    sq = I(-3, 2).square()
    res["even_power_cross_zero"] = bool(sq.lo == 0 and sq.hi == 9)
