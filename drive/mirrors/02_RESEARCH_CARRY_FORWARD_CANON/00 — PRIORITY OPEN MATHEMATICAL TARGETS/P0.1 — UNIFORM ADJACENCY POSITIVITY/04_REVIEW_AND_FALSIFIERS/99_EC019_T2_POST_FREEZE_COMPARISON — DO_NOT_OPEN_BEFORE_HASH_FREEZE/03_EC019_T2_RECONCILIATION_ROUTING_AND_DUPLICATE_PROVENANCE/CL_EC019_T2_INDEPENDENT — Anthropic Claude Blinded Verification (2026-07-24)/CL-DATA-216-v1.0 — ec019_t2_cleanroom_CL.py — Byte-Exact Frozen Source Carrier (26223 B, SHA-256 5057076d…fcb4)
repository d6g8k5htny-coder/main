# =====================================================================
# 1.  Rigorous interval arithmetic over exact rationals
# =====================================================================


class I:
    """Closed interval [lo, hi] with exact rational endpoints."""
    __slots__ = ("lo", "hi")

    def __init__(self, lo, hi=None):
        if hi is None:
            hi = lo
        lo = Q(lo)
        hi = Q(hi)
        if lo > hi:
            raise ValueError("empty interval: lo > hi")
        self.lo = lo
        self.hi = hi

    @staticmethod
    def _as(x):
        return x if isinstance(x, I) else I(Q(x))

    def lower(self):
        return self.lo

    def upper(self):
        return self.hi

    # ---- additive group ----
    def __add__(a, b):
        b = I._as(b)
        return I(a.lo + b.lo, a.hi + b.hi)

    __radd__ = __add__

    def __neg__(a):
        return I(-a.hi, -a.lo)

    def __sub__(a, b):
        b = I._as(b)
        return I(a.lo - b.hi, a.hi - b.lo)

    def __rsub__(a, b):
        return I._as(b).__sub__(a)

    # ---- multiplication ----
    def __mul__(a, b):
        b = I._as(b)
        p = (a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi)
        return I(min(p), max(p))

    __rmul__ = __mul__

    def reciprocal(a):
        if a.lo <= 0 <= a.hi:
            raise ZeroDivisionError("reciprocal of interval containing 0")
        return I(Q(1) / a.hi, Q(1) / a.lo)

    def __truediv__(a, b):
        b = I._as(b)
        return a * b.reciprocal()

    def __rtruediv__(a, b):
        return I._as(b).__truediv__(a)

    # ---- powers with correct even/odd semantics ----
    def square(a):
        if a.lo >= 0:
            return I(a.lo * a.lo, a.hi * a.hi)
        if a.hi <= 0:
            return I(a.hi * a.hi, a.lo * a.lo)
        m = max(-a.lo, a.hi)
        return I(Q(0), m * m)

    def intpow(a, n):
        if n < 0:
            raise ValueError("negative power")
        if n == 0:
            return I(Q(1), Q(1))
        if n == 1:
            return I(a.lo, a.hi)
        if n % 2 == 1:                       # odd -> x^n monotone increasing on R
            return I(a.lo ** n, a.hi ** n)
        s = a.square()                       # even -> (x^2)^(n/2), s >= 0 monotone
        k = n // 2
        return I(s.lo ** k, s.hi ** k)

    # ---- absolute value / sup ----
    def absI(a):
        if a.lo >= 0:
            return I(a.lo, a.hi)
        if a.hi <= 0:
            return I(-a.hi, -a.lo)
        return I(Q(0), max(-a.lo, a.hi))

    def supabs(a):
        return max(abs(a.lo), abs(a.hi))

    def __repr__(a):
        return "I(%s, %s)" % (a.lo, a.hi)


# =====================================================================
# 2.  Directed square-root enclosure
#
#   For rational x = p/q >= 0 and integer scale D >= 1:
#       lower := isqrt(floor(x*D^2)) / D
#       upper := (isqrt(ceil (x*D^2)) + 1) / D
#
#   Proof of enclosure.
#     isqrt(n) = floor(sqrt(n)), so isqrt(n)^2 <= n <= (isqrt(n)+1)^2.
#     lower^2 = isqrt(floor(x D^2))^2 / D^2 <= floor(x D^2)/D^2 <= x,  so lower <= sqrt(x).
#     upper    = (isqrt(ceil(x D^2)) + 1)/D  > sqrt(ceil(x D^2))/D >= sqrt(x D^2)/D = sqrt(x).
#   Hence lower <= sqrt(x) <= upper and lower^2 <= x <= upper^2.
# =====================================================================


def sqrt_lower(x, D):
    x = Q(x)
    assert x >= 0
    n = x * D * D                 # nonnegative rational
    fl = n.numerator // n.denominator          # floor (denominator > 0)
    return Q(math.isqrt(fl), D)


def sqrt_upper(x, D):
    x = Q(x)
    assert x >= 0
    n = x * D * D
    ce = -((-n.numerator) // n.denominator)    # ceil
    return Q(math.isqrt(ce) + 1, D)


def isqrt_interval(iv, D):
    assert iv.lo >= 0
    return I(sqrt_lower(iv.lo, D), sqrt_upper(iv.hi, D))


