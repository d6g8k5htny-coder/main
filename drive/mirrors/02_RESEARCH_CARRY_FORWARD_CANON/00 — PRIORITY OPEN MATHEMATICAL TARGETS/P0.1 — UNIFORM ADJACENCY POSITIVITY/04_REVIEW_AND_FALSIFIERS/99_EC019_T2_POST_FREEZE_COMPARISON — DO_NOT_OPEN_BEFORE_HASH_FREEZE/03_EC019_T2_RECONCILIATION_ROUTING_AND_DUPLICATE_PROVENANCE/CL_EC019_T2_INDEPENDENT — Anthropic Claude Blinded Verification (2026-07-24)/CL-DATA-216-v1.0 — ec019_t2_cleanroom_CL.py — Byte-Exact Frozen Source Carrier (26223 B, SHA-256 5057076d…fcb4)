def certificate(cr, D, kappa=KAPPA0):
    """Validate the box then compute the 19 margins as exact rational
    one-sided certificates.  Returns (margins, derived).
    margins[name] is a Fraction, or None if its gate is structurally
    undefined (treated as 'not strictly positive')."""
    validate_box(cr)
    P = box_intervals(cr)
    a, w, z, s = P["a"], P["w"], P["z"], P["s"]
    c40, c31, c22, c13, c04 = P["c40"], P["c31"], P["c22"], P["c13"], P["c04"]
    r = R
    sigma = SIGMA
    KAP = kappa

    # mu = 1 / (40 sqrt 2)  -> rigorous interval
    s2 = I(sqrt_lower(2, D), sqrt_upper(2, D))
    mu = (s2 * 40).reciprocal()

    # ---- degree-four flow (Sec 4) ----
    def Fx(X, Y):
        return (X.square() - Q(1, 4) + a * X * Y + (w * Q(1, 2)) * Y.square()
                + r * (c40 * (X.intpow(3) - X * Q(1, 4)) * Q(1, 6)
                       + c31 * (X.square() * 3 - Q(1, 4)) * Y * Q(1, 6)
                       + c22 * X * Y.square() * Q(1, 2)
                       + c13 * Y.intpow(3) * Q(1, 6)))

    def Fy(X, Y):
        return (a * (X.square() - Q(1, 4)) * Q(1, 2) + s * Y + w * X * Y
                + (z * Q(1, 2)) * Y.square()
                + r * (c31 * (X.intpow(3) - X * Q(1, 4)) * Q(1, 6)
                       + c22 * X.square() * Y * Q(1, 2)
                       + c13 * X * Y.square() * Q(1, 2)
                       + c04 * Y.intpow(3) * Q(1, 6)))

    def J11(X, Y):
        return (X * 2 + a * Y
                + r * (c40 * (X.square() * 3 - Q(1, 4)) * Q(1, 6)
                       + c31 * X * Y + c22 * Y.square() * Q(1, 2)))

    def J12(X, Y):
        return (a * X + w * Y
                + r * (c31 * (X.square() * 3 - Q(1, 4)) * Q(1, 6)
                       + c22 * X * Y + c13 * Y.square() * Q(1, 2)))

    def J22(X, Y):
        return (s + w * X + z * Y
                + r * (c22 * X.square() * Q(1, 2)
                       + c13 * X * Y + c04 * Y.square() * Q(1, 2)))

    # ---- witness / strip quantities (Sec 5) ----
    F = a.absI() * Q(1, 8) + r * c31.absI() * Q(1, 48)
    A = (z.absI() + r * c13.absI() * Q(1, 2)) * F
    B = r * c04.absI() * F.square() * Q(1, 2)
    C = (w.absI() * Q(1, 2) + mu + r * c22.absI() * Q(1, 8)
         + A / mu + B / mu.square())
    W = F / mu
    m_threshold = (-s - C).lower()

    # ---- endpoint typing / unstable-slope gates (Sec 6) ----
    A_S = 1 + r * c40 * Q(1, 12)
    B_S = a * Q(1, 2) + r * c31 * Q(1, 12)
    D_S = s + w * Q(1, 2) + r * c22 * Q(1, 8)
    det_S = A_S * D_S - B_S.square()

    A_M = -1 + r * c40 * Q(1, 12)
    B_M = -(a * Q(1, 2)) + r * c31 * Q(1, 12)
    D_M = s - w * Q(1, 2) + r * c22 * Q(1, 8)
    det_M = A_M * D_M - B_M.square()

    g = A_S - D_S
    if g.lower() > 0:
        tau_upper = B_S.supabs() / g.lower()
        m_cone_slope = KAP - 2 * tau_upper
    else:
        tau_upper = None
        m_cone_slope = None          # cone-slope gate fails structurally

    m_saddle_det = -det_S.upper()
    m_max_A = -A_M.upper()
    m_max_D = -D_M.upper()
    m_max_det = det_M.lower()
    m_axial = g.lower()

    # ---- S-side cone & handoff gates (Sec 7) ----
    def Qx(xi, t):
        num = (a * t * xi * 12 - a * t * 6
               - c13 * r * t.intpow(3) * xi.square() * 2
               + c22 * r * t.square() * xi.square() * 6
               - c22 * r * t.square() * xi * 3
               - c31 * r * t * xi.square() * 6
               + c31 * r * t * xi * 6
               - c31 * r * t
               + c40 * r * xi.square() * 2
               - c40 * r * xi * 3
               + c40 * r
               - t.square() * w * xi * 6
               - xi * 12 + I(Q(12)))
        return num * Q(1, 12)

    def Qy(xi, t):
        num = (a * xi * 12 - a * 12
               + c04 * r * t.intpow(3) * xi.square() * 4
               - c13 * r * t.square() * xi.square() * 12
               + c13 * r * t.square() * xi * 6
               + c22 * r * t * xi.square() * 12
               - c22 * r * t * xi * 12
               + c22 * r * t * 3
               - c31 * r * xi.square() * 4
               + c31 * r * xi * 6
               - c31 * r * 2
               + s * t * 24
               + t.square() * xi * z * 12
               - t * w * xi * 24
               + t * w * 12)
        return num * Q(1, 24)

    xi_iv = I(Q(0), sigma)
    t_iv = I(-KAP, KAP)
    t_pos = I(KAP)
    t_neg = I(-KAP)

    m_cone_axis = Qx(xi_iv, t_iv).lower()
    m_cone_upper = (Qx(xi_iv, t_pos) * KAP - Qy(xi_iv, t_pos)).lower()
    m_cone_lower = (Qx(xi_iv, t_neg) * KAP + Qy(xi_iv, t_neg)).lower()
    m_handoff = W.lower() * Q(1, 2) - KAP * sigma

    # ---- central strip gates (Sec 8) ----
    Xc = I(sigma - Q(1, 2), Q(1, 2) - sigma)
    Wlo, Whi = W.lower(), W.upper()
    Ytop = I(Wlo, Whi)
    Ybot = I(-Whi, -Wlo)
    Ystrip = I(-Whi, Whi)

    m_strip_top = (-Fy(Xc, Ytop)).lower()
    m_strip_bottom = (Fy(Xc, Ybot)).lower()
    m_central_drift = (-Fx(Xc, Ystrip)).lower()
    m_transverse_contraction = -(J22(Xc, Ystrip)).upper()

    # ---- M-side capture ball & sink gates (Sec 9) ----
    rho = isqrt_interval(I(sigma * sigma) + W.square(), D) * 2
    rho_u = rho.upper()
    Xcap = I(Q(-1, 2) - rho_u, Q(-1, 2) + rho_u)
    Ycap = I(-rho_u, rho_u)
    j11 = J11(Xcap, Ycap)
    j12 = J12(Xcap, Ycap)
    j22 = J22(Xcap, Ycap)
    offdiag = j12.supabs()

    m_chart_X = Q(3, 4) - (Q(1, 2) + rho_u)
    m_chart_Y = 1 - rho_u
    m_gersh_1 = (-j11).lower() - offdiag
    m_gersh_2 = (-j22).lower() - offdiag

    margins = {
        "m_threshold": m_threshold,
        "m_saddle_det": m_saddle_det,
        "m_max_A": m_max_A,
        "m_max_D": m_max_D,
        "m_max_det": m_max_det,
        "m_axial": m_axial,
        "m_cone_slope": m_cone_slope,
        "m_cone_axis": m_cone_axis,
        "m_cone_upper": m_cone_upper,
        "m_cone_lower": m_cone_lower,
        "m_handoff": m_handoff,
        "m_strip_top": m_strip_top,
        "m_strip_bottom": m_strip_bottom,
        "m_central_drift": m_central_drift,
        "m_transverse_contraction": m_transverse_contraction,
        "m_chart_X": m_chart_X,
        "m_chart_Y": m_chart_Y,
        "m_gersh_1": m_gersh_1,
        "m_gersh_2": m_gersh_2,
    }
    derived = {"W": W, "rho": rho, "tau_upper": tau_upper, "mu": mu, "F": F}
    return margins, derived


def margin_positive(v):
    return (v is not None) and (v > 0)


def all_positive(margins):
    return all(margin_positive(margins[nm]) for nm in MARGIN_NAMES)


