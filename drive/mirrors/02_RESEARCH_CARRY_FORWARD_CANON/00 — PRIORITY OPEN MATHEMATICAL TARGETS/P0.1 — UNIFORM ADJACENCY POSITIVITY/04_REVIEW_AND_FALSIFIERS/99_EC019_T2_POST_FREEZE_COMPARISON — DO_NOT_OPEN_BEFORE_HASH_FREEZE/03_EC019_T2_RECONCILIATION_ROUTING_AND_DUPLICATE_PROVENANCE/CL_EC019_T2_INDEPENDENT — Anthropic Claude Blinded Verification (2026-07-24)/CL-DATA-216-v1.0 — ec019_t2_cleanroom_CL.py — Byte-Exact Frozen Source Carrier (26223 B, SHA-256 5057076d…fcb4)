def dec_str(q, places=50):
    """Exact truncated-toward-zero decimal string, deterministic."""
    q = Q(q)
    sign = "-" if q < 0 else ""
    q = -q if q < 0 else q
    whole = q.numerator // q.denominator
    frac = q - whole
    out = []
    for _ in range(places):
        frac *= 10
        d = frac.numerator // frac.denominator
        out.append(str(d))
        frac -= d
    return "%s%d.%s" % (sign, whole, "".join(out))


def ser_frac(q, places=50):
    if q is None:
        return None
    q = Q(q)
    return {"q": "%d/%d" % (q.numerator, q.denominator), "dec": dec_str(q, places)}


def ser_interval(iv, places=50):
    return {"lo": ser_frac(iv.lo, places), "hi": ser_frac(iv.hi, places)}


def ser_margins(margins):
    out = {}
    for nm in MARGIN_NAMES:
        v = margins[nm]
        if v is None:
            out[nm] = {"q": None, "dec": None, "positive": False, "gate": "STRUCTURAL_FAIL"}
        else:
            out[nm] = {"q": "%d/%d" % (v.numerator, v.denominator),
                       "dec": dec_str(v, 50),
                       "positive": bool(v > 0)}
    return out


def ser_derived(derived):
    out = {}
    for k in ("W", "rho", "mu", "F"):
        out[k] = ser_interval(derived[k])
    tu = derived["tau_upper"]
    out["tau_upper"] = ser_frac(tu) if tu is not None else None
    return out


