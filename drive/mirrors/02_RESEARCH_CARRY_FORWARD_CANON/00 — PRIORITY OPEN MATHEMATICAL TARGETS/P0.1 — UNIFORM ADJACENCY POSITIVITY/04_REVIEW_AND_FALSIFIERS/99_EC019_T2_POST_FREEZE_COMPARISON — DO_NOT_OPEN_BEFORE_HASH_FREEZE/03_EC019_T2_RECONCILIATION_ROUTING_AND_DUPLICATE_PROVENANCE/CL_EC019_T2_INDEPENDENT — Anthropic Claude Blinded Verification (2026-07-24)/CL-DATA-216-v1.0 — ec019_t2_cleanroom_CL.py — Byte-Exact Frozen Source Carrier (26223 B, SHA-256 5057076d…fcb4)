    if not st["all_pass"]:
        verdict = "T2 - INCONCLUSIVE"
        verdict_reason = "self-tests failed (rigorous arithmetic not established)"
    elif (all_pos_all_P and signs_stable and controls_fired_all_P
          and mutations_all_fail):
        verdict = "T2 - PASS"
        verdict_reason = ("all nineteen margins strictly positive and sign-stable "
                          "across P in {40,100,200}; all five controls executed and "
                          "fired at every precision; all nine zero-radius mutations "
                          "rejected by the validator")
    elif not all_pos_all_P:
        failing = [nm for nm in MARGIN_NAMES
                   if not margin_positive(certificate(primary_box, 10 ** 200)[0][nm])]
        verdict = "T2 - FAIL"
        verdict_reason = "non-positive margin(s) under correct implementation: " + ",".join(failing)
    else:
        verdict = "T2 - INCONCLUSIVE"
        verdict_reason = ("instability or control/validator coverage gap: "
                          "signs_stable=%s controls_fired=%s mutations=%s"
                          % (signs_stable, controls_fired_all_P, mutations_all_fail))

    result = {
        "artifact_class": "CL independent EC-019 T2 clean-room result",
        "object": "EC-019 Test T2 - Route-B degree-four capture margins (fixed r=1/20)",
        "provider": "Anthropic",
        "model_line": "Claude Opus (claude-opus-4-8)",
        "governing_prereg": "CL-REG-214-v1.0",
        "permitted_interface": "GP-SPEC-166-v1.0",
        "precision_policy_P": PRECISIONS_P,
        "python_version": "3.11.15",
        "arithmetic": "exact rational (fractions.Fraction) interval arithmetic; "
                      "directed isqrt square-root enclosure; stdlib only",
        "fixed_constants": {"r": "1/20", "sigma": "1/10", "kappa": "1/100",
                            "mu": "1/(40*sqrt(2))"},
        "primary_box": box_ser,
        "primary_by_precision": by_prec,
        "primary_signs_stable_across_P": bool(signs_stable),
        "primary_all_positive_all_P": bool(all_pos_all_P),
        "controls_by_precision": controls_by_prec,
        "controls_fired_all_P": bool(controls_fired_all_P),
        "zero_radius_mutations": mutations,
        "zero_radius_mutations_all_fail": bool(mutations_all_fail),
        "self_tests": st,
        "verdict": verdict,
        "verdict_reason": verdict_reason,
        "scope_firewall": ("closes only the independent-verification gate for the "
                           "fixed-r qualitative object; no T1, no promotion, no "
                           "probability, no r-uniformity, no P0.1/P0.2/Theorem B, no "
                           "automation activation, no machine-root replacement, no "
                           "seal, no release, no deletion"),
    }

    result_bytes = json.dumps(result, sort_keys=True, indent=2,
                              ensure_ascii=True).encode("utf-8") + b"\n"
    with open("ec019_t2_result_CL.json", "wb") as fh:
        fh.write(result_bytes)
    result_sha = hashlib.sha256(result_bytes).hexdigest()

    with open(__file__, "rb") as fh:
        source_bytes = fh.read()
    source_sha = hashlib.sha256(source_bytes).hexdigest()

    # ---- human-readable summary to stdout ----
    print("=" * 68)
    print("EC-019 T2 CL independent clean-room run")
    print("=" * 68)
    print("self-tests all_pass :", st["all_pass"])
    print("precision policy P  :", PRECISIONS_P)
    print("-" * 68)
    mg200, dv200 = certificate(primary_box, 10 ** 200)
    for nm in MARGIN_NAMES:
        v = mg200[nm]
        tag = "POS " if margin_positive(v) else "**NONPOS**"
        print("  %-26s %s  %s" % (nm, tag, dec_str(v, 18) if v is not None else "GATE-FAIL"))
    print("-" * 68)
    print("W       (P=200):", dec_str(dv200["W"].lower(), 18), "..", dec_str(dv200["W"].upper(), 18))
    print("rho     (P=200):", dec_str(dv200["rho"].lower(), 18), "..", dec_str(dv200["rho"].upper(), 18))
    print("tau_up  (P=200):", dec_str(dv200["tau_upper"], 18))
    print("-" * 68)
    print("all positive @ all P  :", all_pos_all_P)
    print("signs stable across P :", signs_stable)
    print("controls fired @ all P:", controls_fired_all_P)
    for P in PRECISIONS_P:
        row = controls_by_prec[str(P)]
        print("    P=%-4d NC1..NC5 fired: %s" % (
            P, [row[nc]["fired"] for nc in ("NC1", "NC2", "NC3", "NC4", "NC5")]))
    print("zero-radius mutations all fail:", mutations_all_fail)
    print("    ", {nm: mutations[nm]["validator_fail"] for nm in PARAM_NAMES})
    print("-" * 68)
    print("VERDICT :", verdict)
    print("reason  :", verdict_reason)
    print("-" * 68)
    print("source_sha256 :", source_sha)
    print("source_bytes  :", len(source_bytes))
    print("result_sha256 :", result_sha)
    print("result_bytes  :", len(result_bytes))
    print("=" * 68)

    return result_sha, len(result_bytes)


