def certificate(p, kappa, P):
    """All nineteen rigorous one-sided bounds (exact rationals) + aux."""
    out = {}

    s2 = isqrt_interval(I(2, 2), P)
    mu = I(1, 1) / (40 * s2)

    Fq = iabs(p["a"]) / 8 + R * iabs(p["c31"]) / 48
    Aq = (iabs(p["z"]) + R * iabs(p["c13"]) / 2) * Fq
    Bq = R * iabs(p["c04"]) * sq(Fq) / 2
    Cq = iabs(p["w"]) / 2 + mu + R * iabs(p["c22"]) / 8 + Aq / mu + Bq / sq(mu)
    W = Fq / mu
    out["m_threshold"] = ((-p["s"]) - Cq).a

    A_S = 1 + R * p["c40"] / 12
    B_S = p["a"] / 2 + R * p["c31"] / 12
    D_S = p["s"] + p["w"] / 2 + R * p["c22"] / 8
    det_S = A_S * D_S - sq(B_S)
    A_M = -1 + R * p["c40"] / 12
    B_M = (-p["a"]) / 2 + R * p["c31"] / 12
    D_M = p["s"] - p["w"] / 2 + R * p["c22"] / 8
    det_M = A_M * D_M - sq(B_M)
    g = A_S - D_S

    out["m_saddle_det"] = -det_S.b
    out["m_max_A"] = -A_M.b
    out["m_max_D"] = -D_M.b
    out["m_max_det"] = det_M.a
    out["m_axial"] = g.a
    gate_ok = g.a > 0
    tau_up = (supabs(B_S) / g.a) if gate_ok else None
    out["m_cone_slope"] = (kappa - 2 * tau_up) if gate_ok else Fr(-1)

    xi = I(0, SIGMA)
    t_full = I(-kappa, kappa)
    t_pos = I(kappa, kappa)
    t_neg = I(-kappa, -kappa)
    out["m_cone_axis"] = Q_x(xi, t_full, p).a
    out["m_cone_upper"] = (kappa * Q_x(xi, t_pos, p) - Q_y(xi, t_pos, p)).a
    out["m_cone_lower"] = (kappa * Q_x(xi, t_neg, p) + Q_y(xi, t_neg, p)).a
    out["m_handoff"] = W.a / 2 - kappa * SIGMA

    X_c = I(Fr(-1, 2) + SIGMA, Fr(1, 2) - SIGMA)
    Y_top = W
    Y_bot = I(-W.b, -W.a)
    Y_strip = I(-W.b, W.b)
    out["m_strip_top"] = (-F_y(X_c, Y_top, p)).a
    out["m_strip_bottom"] = F_y(X_c, Y_bot, p).a
    out["m_central_drift"] = (-F_x(X_c, Y_strip, p)).a
    out["m_transverse_contraction"] = -J22(X_c, Y_strip, p).b

    rho = 2 * isqrt_interval(sq(I(SIGMA, SIGMA)) + sq(W), P)
    ru = rho.b
    X_cap = I(Fr(-1, 2) - ru, Fr(-1, 2) + ru)
    Y_cap = I(-ru, ru)
    j11 = J11(X_cap, Y_cap, p)
    j12 = J12(X_cap, Y_cap, p)
    j22 = J22(X_cap, Y_cap, p)
    off = supabs(j12)
    out["m_chart_X"] = Fr(3, 4) - (Fr(1, 2) + ru)
    out["m_chart_Y"] = Fr(1) - ru
    out["m_gersh_1"] = (-j11.b) - off
    out["m_gersh_2"] = (-j22.b) - off

    aux = {
        "mu": (mu.a, mu.b),
        "W": (W.a, W.b),
        "rho": (rho.a, rho.b),
        "tau_upper": tau_up,
        "cone_slope_gate_ok": gate_ok,
    }
    return out, aux


# ---------------------------------------------------------------------------
# Display helpers (outward rounding for decimals; exact p/q kept alongside).
# ---------------------------------------------------------------------------
def dec_floor(fr, digits=60):
    return str(Context(prec=digits, rounding=ROUND_FLOOR).divide(
        Decimal(fr.numerator), Decimal(fr.denominator)))


def dec_ceil(fr, digits=60):
    return str(Context(prec=digits, rounding=ROUND_CEILING).divide(
        Decimal(fr.numerator), Decimal(fr.denominator)))


def rational(fr):
    return {"num": str(fr.numerator), "den": str(fr.denominator)}


