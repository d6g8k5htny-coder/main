def build(spec):
    box = {}
    radii = {}
    for k, (c, r) in spec.items():
        radii[k] = r
        box[k] = I(c - r, c + r)
    return box, radii


def validate_full_dimensional(radii):
    bad = [k for k in PNAMES if (k not in radii) or (radii[k] <= 0)]
    return (len(bad) == 0), bad


# ---------------------------------------------------------------------------
# Section 4 — flow and Hessian entries.
# ---------------------------------------------------------------------------
def F_x(X, Y, p):
    return (sq(X) - Fr(1, 4) + p["a"] * X * Y + p["w"] * sq(Y) / 2
            + R * (p["c40"] * (ipow(X, 3) - X / 4) / 6
                   + p["c31"] * (3 * sq(X) - Fr(1, 4)) * Y / 6
                   + p["c22"] * X * sq(Y) / 2
                   + p["c13"] * ipow(Y, 3) / 6))


def F_y(X, Y, p):
    return (p["a"] * (sq(X) - Fr(1, 4)) / 2 + p["s"] * Y + p["w"] * X * Y
            + p["z"] * sq(Y) / 2
            + R * (p["c31"] * (ipow(X, 3) - X / 4) / 6
                   + p["c22"] * sq(X) * Y / 2
                   + p["c13"] * X * sq(Y) / 2
                   + p["c04"] * ipow(Y, 3) / 6))


def J11(X, Y, p):
    return (2 * X + p["a"] * Y
            + R * (p["c40"] * (3 * sq(X) - Fr(1, 4)) / 6
                   + p["c31"] * X * Y + p["c22"] * sq(Y) / 2))


def J12(X, Y, p):
    return (p["a"] * X + p["w"] * Y
            + R * (p["c31"] * (3 * sq(X) - Fr(1, 4)) / 6
                   + p["c22"] * X * Y + p["c13"] * sq(Y) / 2))


def J22(X, Y, p):
    return (p["s"] + p["w"] * X + p["z"] * Y
            + R * (p["c22"] * sq(X) / 2 + p["c13"] * X * Y
                   + p["c04"] * sq(Y) / 2))


# ---------------------------------------------------------------------------
# Section 7 — cone polynomials (xi-quotient cancelled; xi = 0 included).
# ---------------------------------------------------------------------------
def Q_x(xi, t, p):
    n = (12 * p["a"] * t * xi - 6 * p["a"] * t
         - 2 * p["c13"] * R * ipow(t, 3) * sq(xi)
         + 6 * p["c22"] * R * sq(t) * sq(xi) - 3 * p["c22"] * R * sq(t) * xi
         - 6 * p["c31"] * R * t * sq(xi) + 6 * p["c31"] * R * t * xi
         - p["c31"] * R * t
         + 2 * p["c40"] * R * sq(xi) - 3 * p["c40"] * R * xi + p["c40"] * R
         - 6 * sq(t) * p["w"] * xi - 12 * xi + 12)
    return n / 12


def Q_y(xi, t, p):
    n = (12 * p["a"] * xi - 12 * p["a"]
         + 4 * p["c04"] * R * ipow(t, 3) * sq(xi)
         - 12 * p["c13"] * R * sq(t) * sq(xi) + 6 * p["c13"] * R * sq(t) * xi
         + 12 * p["c22"] * R * t * sq(xi) - 12 * p["c22"] * R * t * xi
         + 3 * p["c22"] * R * t
         - 4 * p["c31"] * R * sq(xi) + 6 * p["c31"] * R * xi
         - 2 * p["c31"] * R
         + 24 * p["s"] * t + 12 * sq(t) * xi * p["z"]
         - 24 * t * p["w"] * xi + 12 * t * p["w"])
    return n / 24


MARGINS = [
    "m_threshold", "m_saddle_det", "m_max_A", "m_max_D", "m_max_det",
