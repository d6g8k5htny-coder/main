# ---------------------------------------------------------------------------
# Directed square root on exact rationals (pure integer; runtime-proven).
# ---------------------------------------------------------------------------
def sqrt_enclosure(x, P):
    """Return (lo, hi) rationals with lo^2 <= x <= hi^2, width <= 2/10^P."""
    assert x >= 0
    D = 10 ** P
    n = (x.numerator * D * D) // x.denominator          # floor(x * D^2)
    L = isqrt(n)
    lo = Fr(L, D)
    hi = Fr(L + 1, D)
    assert lo * lo <= x <= hi * hi, "sqrt enclosure violated"
    return lo, hi


# ---------------------------------------------------------------------------
# Exact-rational interval.
# ---------------------------------------------------------------------------
class I:
    __slots__ = ("a", "b")           # a = lower endpoint, b = upper endpoint

    def __init__(self, a, b=None):
        if b is None:
            b = a
        a = Fr(a)
        b = Fr(b)
        if a > b:
            raise ValueError("inverted interval")
        self.a = a
        self.b = b

    @staticmethod
    def of(x):
        return x if isinstance(x, I) else I(Fr(x))

    def __add__(self, o):
        o = I.of(o)
        return I(self.a + o.a, self.b + o.b)
    __radd__ = __add__

    def __sub__(self, o):
        o = I.of(o)
        return I(self.a - o.b, self.b - o.a)

    def __rsub__(self, o):
        return I.of(o) - self

    def __mul__(self, o):
        o = I.of(o)
        c = (self.a * o.a, self.a * o.b, self.b * o.a, self.b * o.b)
        return I(min(c), max(c))
    __rmul__ = __mul__

    def __truediv__(self, o):
        o = I.of(o)
        if o.a <= 0 <= o.b:
            raise ZeroDivisionError("FAIL-CLOSED: divisor interval contains 0")
        c = (self.a / o.a, self.a / o.b, self.b / o.a, self.b / o.b)
        return I(min(c), max(c))

    def __rtruediv__(self, o):
        return I.of(o) / self

    def __neg__(self):
        return I(-self.b, -self.a)


def ipow(x, n):
    if n == 1:
        return x
    if n % 2 == 1:
        return I(x.a ** n, x.b ** n)
    if x.a >= 0:
        return I(x.a ** n, x.b ** n)
    if x.b <= 0:
        return I(x.b ** n, x.a ** n)
    return I(Fr(0), max(x.a ** n, x.b ** n))


def sq(x):
    return ipow(x, 2)


def iabs(x):
    if x.a >= 0:
        return I(x.a, x.b)
    if x.b <= 0:
        return I(-x.b, -x.a)
    return I(Fr(0), max(-x.a, x.b))


def supabs(x):
    return max(abs(x.a), abs(x.b))


def isqrt_interval(x, P):
    assert x.a >= 0
    lo, _ = sqrt_enclosure(x.a, P)
    _, hi = sqrt_enclosure(x.b, P)
    return I(lo, hi)


