            "aux": {
                "mu": {"lo": dec_floor(aux["mu"][0]), "hi": dec_ceil(aux["mu"][1])},
                "W": {"lo": dec_floor(aux["W"][0]), "hi": dec_ceil(aux["W"][1])},
