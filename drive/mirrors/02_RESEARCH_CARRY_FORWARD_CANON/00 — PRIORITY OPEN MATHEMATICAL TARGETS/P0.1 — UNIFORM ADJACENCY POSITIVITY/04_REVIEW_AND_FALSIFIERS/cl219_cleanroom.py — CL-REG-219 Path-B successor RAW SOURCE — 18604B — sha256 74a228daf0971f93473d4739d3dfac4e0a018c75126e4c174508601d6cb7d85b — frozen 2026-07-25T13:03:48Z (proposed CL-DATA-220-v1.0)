        "full_dimensionality": {"primary_ok": fd_ok, "failing": fd_bad},
        "per_precision": per_p,
        "sign_and_control_stability_across_ladder": stable,
        "zero_radius_mutations": mutations,
        "all_mutations_rejected": all(v["rejected"] for v in mutations.values()),
        "regression_tests": regressions,
