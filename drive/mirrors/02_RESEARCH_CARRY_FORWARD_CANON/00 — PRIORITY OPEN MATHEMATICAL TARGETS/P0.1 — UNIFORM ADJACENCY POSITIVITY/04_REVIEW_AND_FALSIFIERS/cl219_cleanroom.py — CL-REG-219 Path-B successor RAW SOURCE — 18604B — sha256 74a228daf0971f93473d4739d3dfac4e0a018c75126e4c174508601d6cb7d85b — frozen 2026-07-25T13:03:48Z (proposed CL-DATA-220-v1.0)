# Regression tests (executed, recorded).
# ---------------------------------------------------------------------------
def run_regressions():
    t = {}

    lo, hi = sqrt_enclosure(Fr(2), 6)
    t["sqrt_containment_low_precision"] = bool(lo * lo <= 2 <= hi * hi and lo < hi)

    x = I(Fr(-3, 7), Fr(2, 5))
    y = I(Fr(1, 3), Fr(9, 4))
    s = x + y
    d = x - y
    pr = x * y
    q = x / y
    t["containment_add"] = bool(s.a <= Fr(-3, 7) + Fr(1, 3) <= s.b
                                and s.a <= Fr(2, 5) + Fr(9, 4) <= s.b)
    t["containment_sub"] = bool(d.a <= Fr(-3, 7) - Fr(9, 4) <= d.b
                                and d.a <= Fr(2, 5) - Fr(1, 3) <= d.b)
    t["containment_mul"] = bool(pr.a <= Fr(-3, 7) * Fr(9, 4) <= pr.b
                                and pr.a <= Fr(2, 5) * Fr(1, 3) <= pr.b)
    t["containment_div"] = bool(q.a <= Fr(-3, 7) / Fr(1, 3) <= q.b
                                and q.a <= Fr(2, 5) / Fr(9, 4) <= q.b)

    z = sq(I(Fr(-2, 3), Fr(1, 2)))
    t["even_power_zero_crossing"] = bool(z.a == 0 and z.b == Fr(4, 9))

    try:
        _ = I(1, 1) / I(-1, 1)
        t["division_fail_closed"] = False
    except ZeroDivisionError:
        t["division_fail_closed"] = True

    return t


