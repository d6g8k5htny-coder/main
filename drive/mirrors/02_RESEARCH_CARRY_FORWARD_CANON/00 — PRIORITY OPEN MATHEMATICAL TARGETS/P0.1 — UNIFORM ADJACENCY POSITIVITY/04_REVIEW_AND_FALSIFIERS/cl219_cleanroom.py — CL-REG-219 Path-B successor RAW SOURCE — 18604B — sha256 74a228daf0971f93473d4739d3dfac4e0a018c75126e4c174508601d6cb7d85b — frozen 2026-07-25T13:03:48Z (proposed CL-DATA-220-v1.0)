def main():
    box, radii = build(PRIMARY)
    fd_ok, fd_bad = validate_full_dimensional(radii)

    per_p = {}
    for P in LADDER:
        m, aux = certificate(box, KAPPA, P)
        controls = run_controls(P)
        per_p[str(P)] = {
            "margins": {
                k: {
                    "exact_lower_bound": rational(m[k]),
                    "decimal_lower_bound_floor": dec_floor(m[k]),
                    "positive": bool(m[k] > 0),
                } for k in MARGINS
