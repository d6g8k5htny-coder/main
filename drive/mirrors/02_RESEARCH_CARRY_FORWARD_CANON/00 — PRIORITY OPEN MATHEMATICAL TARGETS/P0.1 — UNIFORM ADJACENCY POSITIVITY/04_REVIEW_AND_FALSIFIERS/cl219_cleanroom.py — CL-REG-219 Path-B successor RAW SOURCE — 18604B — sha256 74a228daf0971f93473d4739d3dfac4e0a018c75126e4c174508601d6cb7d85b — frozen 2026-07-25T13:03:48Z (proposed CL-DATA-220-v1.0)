def run_controls(P):
    res = {}

    spec = dict(PRIMARY)
    spec["c04"] = (PRIMARY["c04"][0], Fr(0))
    _, radii = build(spec)
    ok, bad = validate_full_dimensional(radii)
    res["NC1_zero_width"] = {
        "required": "FULL_DIMENSIONAL_BOX_FAIL",
        "validator_ok": ok,
        "failing_radii": bad,
        "fired": (not ok) and ("c04" in bad),
    }

    spec = dict(PRIMARY)
    spec["c40"] = (PRIMARY["c40"][0], Fr(500))
    box, _ = build(spec)
    m, _ = certificate(box, KAPPA, P)
    res["NC2_endpoint_typing"] = {
        "required": "m_saddle_det<=0 OR m_max_det<=0",
        "m_saddle_det": dec_floor(m["m_saddle_det"]),
        "m_max_det": dec_floor(m["m_max_det"]),
        "fired": bool((m["m_saddle_det"] <= 0) or (m["m_max_det"] <= 0)),
    }

    spec = dict(PRIMARY)
    spec["s"] = (PRIMARY["s"][0], Fr(11, 10))
    box, _ = build(spec)
    m, _ = certificate(box, KAPPA, P)
    res["NC3_threshold"] = {
        "required": "m_threshold<=0",
        "m_threshold": dec_floor(m["m_threshold"]),
        "fired": bool(m["m_threshold"] <= 0),
    }

    box, _ = build(PRIMARY)
    m, _ = certificate(box, Fr(5, 10000), P)
    res["NC4_cone_narrow"] = {
        "required": "m_cone_slope<=0",
        "m_cone_slope": dec_floor(m["m_cone_slope"]),
        "fired": bool(m["m_cone_slope"] <= 0),
    }

    spec = dict(PRIMARY)
    spec["a"] = (PRIMARY["a"][0], Fr(1, 2))
    box, _ = build(spec)
    m, _ = certificate(box, KAPPA, P)
    res["NC5_capture_chart"] = {
        "required": "m_chart_X<=0 OR m_gersh_1<=0",
        "m_chart_X": dec_floor(m["m_chart_X"]),
        "m_gersh_1": dec_floor(m["m_gersh_1"]),
        "fired": bool((m["m_chart_X"] <= 0) or (m["m_gersh_1"] <= 0)),
    }
    return res


def run_mutations():
    res = {}
    for k in PNAMES:
        spec = dict(PRIMARY)
        spec[k] = (PRIMARY[k][0], Fr(0))
        _, radii = build(spec)
        ok, bad = validate_full_dimensional(radii)
        res[k] = {"validator_ok": ok, "rejected": (not ok) and (k in bad)}
    return res


