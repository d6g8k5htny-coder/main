"""PRCP bridge feasibility v2 (CL): adds the wide-margin strip re-parameterization.
S_r unchanged: s <= -C_*(U;r). Bridge conditions may use ANY mu with C_mu <= |s|
(the strip lemma holds at every such mu, at level W=F/mu with damping rate mu).
Design rule: mu_big = largest positive root of mu^3+(beta-|s|)mu^2+A*mu+B=0,
beta=|w|/2+r|c22|/8  ==> smallest admissible strip W_small=F/mu_big.
GRADE: DIAGNOSTIC_ONLY (planar-limit proxy law; no exact-field trajectories)."""
import numpy as np, json
from prcp_law import MEAN, COV

SEED=20260721; RUNGS=[0.05,0.025,0.0125,0.00625]; N=20000; YCAP0=0.3
mean=np.array([float(m) for m in MEAN]); cov=np.array([[float(c) for c in r] for r in COV])
L=np.linalg.cholesky(cov)

def lam_bounds(U,r,ymax):
    a,w,z,c40,c31,c22,c13,c04=U
    LX=(2+r*(abs(c40)/2+abs(c31)*ymax))+2*(abs(a)+r*(abs(c31)/2+abs(c22)*ymax))+(abs(w)+r*(abs(c22)/2+abs(c13)*ymax))
    LY=(abs(a)+r*(abs(c31)/2+abs(c22)*ymax))+2*(abs(w)+r*(abs(c22)/2+abs(c13)*ymax))+(abs(z)+r*(abs(c13)/2+abs(c04)*ymax))
    return max(LX,LY)

def pos_roots(coeffs,tol=1e-9):
    rts=np.roots(coeffs)
    return sorted([x.real for x in rts if abs(x.imag)<1e-8 and x.real>tol])

def per_draw(J9,r,sig_s):
    q=J9[0]; U=J9[1:]; a,w,z,c40,c31,c22,c13,c04=U
    s=q/r
    A_S=1+r*c40/12; B_S=a/2+r*c31/12; D_S=s+w/2+r*c22/8
    A_M=-1+r*c40/12; B_M=-a/2+r*c31/12; D_M=s-w/2+r*c22/8
    detS=A_S*D_S-B_S*B_S; detM=A_M*D_M-B_M*B_M
    typed=(A_M<0 and detM>0 and detS<0)
    rec={'typed':bool(typed),'wgt':abs(detM*detS)}
    if not typed: rec['cls']='NOT_TYPED_MAX_SADDLE'; return rec
    Fq=abs(a)/8+r*abs(c31)/48
    if Fq==0: rec['cls']='DEGENERATE_F0'; return rec
    Amaj=(abs(z)+r*abs(c13)/2)*Fq; Bmaj=r*abs(c04)*Fq**2/2
    beta=abs(w)/2+r*abs(c22)/8
    # C_* via mu_*: largest positive root of mu^3 - Amaj mu - 2 Bmaj
    pr=pos_roots([1,0,-Amaj,-2*Bmaj])
    if not pr: rec['cls']='OPTIMIZER_FAILURE'; return rec
    mus=pr[-1]; Cstar=beta+mus+Amaj/mus+Bmaj/mus**2
    if not s<=-Cstar: rec['cls']='S_R_FAIL'; return rec
    rec['s_margin']=-(s+Cstar)
    # wide-margin strip: largest mu with C_mu <= |s|
    prb=pos_roots([1.0,beta-abs(s),Amaj,Bmaj])
    if not prb: rec['cls']='MU_BIG_FAILURE'; return rec
    mub=prb[-1]
    # guard: verify C_mub <= |s| (numerical)
    if beta+mub+Amaj/mub+Bmaj/mub**2 > abs(s)*(1+1e-9): rec['cls']='MU_BIG_RESIDUAL'; return rec
    W=Fq/mub
    rec['W_bridge']=W; rec['mu_big']=mub
    # sink block first (rho determines sigma_m)
    Ap=-A_M; Bp=-B_M; Dp=-D_M
    if not Dp>Ap: rec['cls']='SINK_GAP_FAIL'; return rec
    lam=Ap-Bp*Bp/(Dp-Ap)
    if lam<=0: rec['cls']='SINK_LAMBDA_FAIL'; return rec
    rho=YCAP0
    for _ in range(3):
        C_M=0.5*lam_bounds(U,r,rho)
        rho=min(YCAP0,0.5*lam/C_M)
    sig_m=min(0.1,0.7*rho)
    if not np.hypot(sig_m,W)<rho: rec['cls']='BALL_ENTRY_FAIL'; return rec
    # cone with W_bridge
    G=A_S-D_S
    if G<=0: rec['cls']='CONE_GAP_FAIL'; return rec
    kap_lo=abs(B_S)/G; kap_hi=W/sig_s
    if not kap_lo<kap_hi: rec['cls']='CONE_INTERVAL_EMPTY'; return rec
    ok=False
    for t in np.linspace(0.05,1.0,20):
        kap=kap_hi*t if kap_lo==0 else kap_lo*(kap_hi/kap_lo)**t
        ymax=min(kap*sig_s,YCAP0)
        eps=0.5*lam_bounds(U,r,ymax)*(1+kap*kap)*sig_s
        c1=A_S-kap*abs(B_S)-eps*np.sqrt(1+kap*kap)
        c2=kap*G-abs(B_S)*(1+kap*kap)-eps*(1+kap)*np.sqrt(1+kap*kap)
        if c1>0 and c2>0: ok=True; rec['kappa']=kap; break
    if not ok: rec['cls']='CONE_EXPANSION_OR_INVARIANCE_FAIL'; return rec
    # transit with W_bridge, asymmetric sigma
    EX=abs(a)*W/2+abs(w)*W**2/2+r*(abs(c40)/(72*np.sqrt(3))+abs(c31)*W/12+abs(c22)*W**2/4+abs(c13)*W**3/6)
    tm=min(sig_s*(1-sig_s),sig_m*(1-sig_m))-EX
    rec['transit_margin']=tm
    if not tm>0: rec['cls']='CENTRAL_TRANSIT_FAIL'; return rec
    rec['cls']='PASS_FEASIBLE'; rec['lam']=lam; rec['rho']=rho; rec['sig_m']=sig_m
    return rec

def run(sig_s,n=N,seed=SEED,nc=None):
    rng=np.random.default_rng(seed); out={}
    for r in RUNGS:
        Z=rng.standard_normal((n,9)); J=mean+Z@L.T
        agg={'typed_w':0.0,'S_w':0.0,'feas_w':0.0,'cls':{},'typed_n':0,'feas_n':0,'w2':0.0,
             'wmin':[],'rhomin':[],'nc2_viol':0}
        for i in range(n):
            rec=per_draw(J[i],r,sig_s)
            if nc=='NC1' and rec['cls']=='S_R_FAIL': rec['cls']='PASS_SRONLY_FLIPPED'
            elif nc=='NC1' and rec.get('s_margin') is not None: rec['cls']='S_R_FAIL'
            cls=rec['cls']; agg['cls'][cls]=agg['cls'].get(cls,0)+1
            w=rec['wgt'] if rec.get('typed') else 0.0
            if rec.get('typed'):
                agg['typed_w']+=w; agg['typed_n']+=1; agg['w2']+=w*w
                if rec.get('s_margin') is not None and cls!='S_R_FAIL': agg['S_w']+=w
                if cls=='PASS_FEASIBLE':
                    agg['feas_w']+=w; agg['feas_n']+=1
                    agg['wmin'].append(rec['W_bridge']); agg['rhomin'].append(rec['rho'])
            if nc=='NC2' and rec.get('s_margin') is not None:
                # fixed-mu substitution check: C_1 must be >= C_* always
                pass
        ess=agg['typed_w']**2/agg['w2'] if agg['w2']>0 else 0
        out[r]={'typed_n':agg['typed_n'],
                'S_frac_w':agg['S_w']/agg['typed_w'] if agg['typed_w'] else 0,
                'feas_frac_w':agg['feas_w']/agg['typed_w'] if agg['typed_w'] else 0,
                'feas_n':agg['feas_n'],'ESS':round(ess),
                'classes':agg['cls'],
                'W_bridge_median':float(np.median(agg['wmin'])) if agg['wmin'] else None,
                'rho_median':float(np.median(agg['rhomin'])) if agg['rhomin'] else None}
    return out

if __name__=='__main__':
    print("=== sigma_S = 0.10 (frozen) ===")
    r1=run(0.10); print(json.dumps({str(k):v for k,v in r1.items()},indent=1))
    print("=== sigma_S = 0.05 (sensitivity) ===")
    r2=run(0.05)
    print(json.dumps({str(k):{kk:v[kk] for kk in('S_frac_w','feas_frac_w','feas_n')} for k,v in r2.items()},indent=1))
    json.dump({'sigma_0.10':{str(k):v for k,v in r1.items()},
               'sigma_0.05':{str(k):v for k,v in r2.items()},
               'seed':SEED,'N':N,'law':'planar-limit exact conditional 9-jet (prcp_law.py)',
               'grade':'DIAGNOSTIC_ONLY'},open('prcp_results.json','w'),indent=1)
    print("wrote prcp_results.json")
