#!/usr/bin/env python3
"""
CL-AUD-044 harness — numerical re-execution of the GP-DER-047 degree-four
capture certificate (P0.2 candidate, deterministic layer).

Implements, with no algebraic simplification, the exact objects frozen in
GP-DER-047 sections 2-3 and machine-checks:
  T-A  displayed endpoint Jacobians J_S, J_M vs numerical differentiation
  T-B  Lemma 4.1  strip: dYdot/dY <= -mu on strip; Ydot(X,+W)<=-1; Ydot(X,-W)>=+1
  T-C  Lemma 5.1/5.2  central: E_X bound and Xdot <= -3RW on central rectangle
  T-D  Lemma 7.2/7.3  cone criterion margins; unstable eigenvector slope < kappa
  T-E  Lemma 8.1/8.3  lambda_min(H) >= 63/128; left section inside B(M,rho);
       inward flow on boundary of B(M,rho)
  T-F  Theorem 9.1  full trajectory: selected leftward unstable branch of S
       integrates to convergence at M (CAPTURE) vs ESCAPE/STALL
Sampling is adversarial: jet vectors at the REG_r boundary, one-hot large
coefficients, s exactly at -C_cap, and beyond.
A single hypothesis-satisfying sample that fails any check is a defect
(falsification conditions 1-6 of GP-DER-047 s17); T-F failure is the
decisive deterministic-layer falsifier.
"""
import numpy as np, json, hashlib, sys
from scipy.integrate import solve_ivp

K = 4096
EPS0 = 1.0 / (1024 * K)          # 1/4194304
RNG = np.random.default_rng(20260721)

def R_of(U):
    return 1.0 + np.sum(np.abs(U))

def geometry(U, r):
    R = R_of(U)
    a,w,z,c40,c31,c22,c13,c04 = U
    F = abs(a)/8 + r*abs(c31)/48
    Fs = 1.0 + F
    mu = K * R**5
    W = Fs / mu
    sigma = 4*R*W
    rho = 8*R*W
    kappa = 1.0/(16*R)
    Ccap = 2*K*R**5 + 2*R
    return dict(R=R,F=F,Fs=Fs,mu=mu,W=W,sigma=sigma,rho=rho,kappa=kappa,Ccap=Ccap)

def field(XY, U, r, s):
    X, Y = XY
    a,w,z,c40,c31,c22,c13,c04 = U
    P4X = (c40/6)*X*(X*X-0.25) + (c31/6)*(3*X*X-0.25)*Y + (c22/2)*X*Y*Y + (c13/6)*Y**3
    P4Y = (c31/6)*X*(X*X-0.25) + (c22/2)*X*X*Y + (c13/2)*X*Y*Y + (c04/6)*Y**3
    Xdot = X*X - 0.25 + a*X*Y + (w/2)*Y*Y + r*P4X
    Ydot = s*Y + (a/2)*(X*X-0.25) + w*X*Y + (z/2)*Y*Y + r*P4Y
    return np.array([Xdot, Ydot])

def J_S_displayed(U, r, s):
    a,w,z,c40,c31,c22,c13,c04 = U
    return np.array([[1 + r*c40/12,  a/2 + r*c31/12],
                     [a/2 + r*c31/12, s + w/2 + r*c22/8]])

def J_M_displayed(U, r, s):
    a,w,z,c40,c31,c22,c13,c04 = U
    return np.array([[-1 + r*c40/12, -a/2 + r*c31/12],
                     [-a/2 + r*c31/12, s - w/2 + r*c22/8]])

def num_jac(P, U, r, s, h=1e-7):
    J = np.zeros((2,2))
    for j in range(2):
        e = np.zeros(2); e[j] = h
        J[:, j] = (field(P+e,U,r,s) - field(P-e,U,r,s)) / (2*h)
    return J

def dYdot_dY(X, Y, U, r, s):
    a,w,z,c40,c31,c22,c13,c04 = U
    return s + w*X + z*Y + r*((c22/2)*X*X + c13*X*Y + (c04/2)*Y*Y)

# ---------------- per-sample battery ----------------
def run_sample(U, r, s_factor, n_grid=41, do_traj=True, Tmax=400.0):
    g = geometry(U, r)
    R,W,mu,sigma,rho,kappa,Ccap = g['R'],g['W'],g['mu'],g['sigma'],g['rho'],g['kappa'],g['Ccap']
    rec = dict(R=R, r=r, s_factor=s_factor, W=W, sigma=sigma, rho=rho, Ccap=Ccap,
               reg_ok = bool(r * R**5 <= EPS0 + 1e-18), fails=[], margins={})
    if not rec['reg_ok']:
        rec['fails'].append('HYPOTHESIS_NOT_MET_REG'); return rec
    s = -s_factor * Ccap
    tol = 1e-9

    # T-A Jacobian consistency
    for P, Jd, name in ((np.array([0.5,0.0]), J_S_displayed(U,r,s),'J_S'),
                        (np.array([-0.5,0.0]), J_M_displayed(U,r,s),'J_M')):
        dev = np.max(np.abs(num_jac(P,U,r,s) - Jd)) / max(1.0, abs(s))
        rec['margins'][f'TA_{name}_reldev'] = float(dev)
        if dev > 1e-5: rec['fails'].append(f'TA_{name}')

    # T-B strip lemma
    Xg = np.linspace(-0.5, 0.5, n_grid)
    Yg = np.linspace(-W, W, n_grid)
    dmax = max(dYdot_dY(X,Y,U,r,s) for X in Xg for Y in Yg)
    rec['margins']['TB_dYdotdY_minus_negmu'] = float(-mu - dmax)   # >=0 required
    if dmax > -mu + tol: rec['fails'].append('TB_partialY')
    top = max(field(np.array([X, W]),U,r,s)[1] for X in Xg)
    bot = min(field(np.array([X,-W]),U,r,s)[1] for X in Xg)
    rec['margins']['TB_top_margin'] = float(-1.0 - top)            # >=0 required
    rec['margins']['TB_bot_margin'] = float(bot - 1.0)
    if top > -1 + tol: rec['fails'].append('TB_topboundary')
    if bot <  1 - tol: rec['fails'].append('TB_botboundary')

    # T-C central transit
    a,w,z,c40,c31,c22,c13,c04 = U
    EX = abs(a)*W/2 + abs(w)*W*W/2 + r*(abs(c40)/(72*np.sqrt(3)) + abs(c31)*W/12
          + abs(c22)*W*W/4 + abs(c13)*W**3/6)
    rec['margins']['TC_EX_over_RW'] = float(EX/(R*W))              # < 0.501 required
    if EX >= 0.501*R*W: rec['fails'].append('TC_EXbound')
    Xc = np.linspace(-0.5+sigma, 0.5-sigma, n_grid)
    xmax = max(field(np.array([X,Y]),U,r,s)[0] for X in Xc for Y in Yg)
    rec['margins']['TC_central_margin'] = float(-3*R*W - xmax)     # >=0 required
    if xmax > -3*R*W + tol: rec['fails'].append('TC_transit')

    # T-D cone
    A = 1 + r*c40/12; B = a/2 + r*c31/12; D = s + w/2 + r*c22/8
    eps = 96 * R * R * W
    c1 = A - kappa*abs(B) - eps*np.sqrt(1+kappa**2)
    c2 = kappa*(A-D) - abs(B)*(1+kappa**2) - eps*(1+kappa)*np.sqrt(1+kappa**2)
    rec['margins']['TD_c1_minus_7over8'] = float(c1 - 7/8)         # >0 claimed
    rec['margins']['TD_c2_minus_511R']   = float(c2 - 511*R)       # >0 claimed
    if c1 <= 7/8 - 1e-12: rec['fails'].append('TD_c1')
    if c2 <= 511*R - 1e-9: rec['fails'].append('TD_c2')
    M2 = np.array([[A,-B],[-B,D]])
    evals, evecs = np.linalg.eigh(M2)
    lu = evals[-1]; v = evecs[:, -1]
    slope = abs(v[1]/v[0]) if abs(v[0]) > 0 else np.inf
    rec['margins']['TD_slope_over_kappa'] = float(slope/kappa)     # <1 required
    if slope >= kappa: rec['fails'].append('TD_slope')
    if not (evals[0] < 0 < evals[-1]): rec['fails'].append('TD_saddle_type')

    # T-E sink
    H = -J_M_displayed(U,r,s)
    lmin = np.linalg.eigvalsh(H)[0]
    rec['margins']['TE_lmin_minus_63over128'] = float(lmin - 63/128)
    if lmin < 63/128 - 1e-12: rec['fails'].append('TE_lmin')
    if np.sqrt(sigma**2 + W**2) >= rho: rec['fails'].append('TE_section_in_ball')
    # inward flow on boundary of B(M,rho)
    Mpt = np.array([-0.5, 0.0])
    worst_rad = -np.inf
    for th in np.linspace(0, 2*np.pi, 72, endpoint=False):
        p = Mpt + rho*np.array([np.cos(th), np.sin(th)])
        rad = np.dot(field(p,U,r,s), p - Mpt)/rho
        worst_rad = max(worst_rad, rad)
    rec['margins']['TE_ball_inward_worst'] = float(-worst_rad)     # >0 required
    if worst_rad >= 0: rec['fails'].append('TE_ball_inward')

    # T-F trajectory
    if do_traj:
        # selected leftward unstable branch in (X,Y): xi=1/2-X so leftward = xi increasing.
        # unstable eigenvector of symmetric [[A,-B],[-B,D]] in (xi,y); map to (X,Y)=(1/2-xi, y)
        xi0 = 1e-3 * rho
        y0 = (v[1]/v[0]) * xi0
        P0 = np.array([0.5 - xi0, y0])
        sol = solve_ivp(lambda t, P: field(P,U,r,s), (0, Tmax), P0,
                        method='LSODA', rtol=1e-10, atol=1e-13, max_step=1.0,
                        dense_output=False, events=None)
        Pend = sol.y[:, -1]
        dM = np.linalg.norm(Pend - Mpt)
        maxabsY = float(np.max(np.abs(sol.y[1])))
        maxX = float(np.max(sol.y[0])); minX = float(np.min(sol.y[0]))
        if dM < rho/4:
            rec['traj'] = 'CAPTURE'
        elif maxX > 0.5 + 1e-6 or minX < -0.5 - rho:
            rec['traj'] = 'ESCAPE'; rec['fails'].append('TF_escape')
        else:
            rec['traj'] = 'STALL';  rec['fails'].append('TF_stall')
        rec['margins']['TF_final_dist_over_rho'] = float(dM/rho)
        rec['margins']['TF_maxabsY_over_W'] = float(maxabsY/W)
        if maxabsY > W*(1+1e-6): rec['fails'].append('TF_strip_violation')
    return rec

# ---------------- sampling plan ----------------
def sample_jets(n):
    out = []
    for i in range(n):
        mode = i % 4
        if mode == 0: U = RNG.normal(0, 1, 8)
        elif mode == 1: U = RNG.standard_cauchy(8) * 0.5
        elif mode == 2:
            U = np.zeros(8); U[RNG.integers(0, 8)] = RNG.choice([-1,1]) * RNG.uniform(1, 6)
        else: U = RNG.normal(0, 3, 8)
        out.append(np.clip(U, -8, 8))
    return out

def main():
    results = []
    jets = sample_jets(96)
    lam_list = [1.0, 0.5, 0.01]          # r = lam * EPS0 / R^5  (1.0 = REG boundary)
    sf_list  = [1.0, 1.001, 10.0]        # s = -sf * C_cap        (1.0 = threshold boundary)
    n_traj = 0
    for U in jets:
        R = R_of(U)
        for lam in lam_list:
            r = lam * EPS0 / R**5
            for sf in sf_list:
                do_traj = (sf in (1.0, 1.001)) or (lam == 1.0)
                rec = run_sample(np.array(U), r, sf, do_traj=do_traj)
                rec['U'] = [float(x) for x in U]
                results.append(rec)
                if 'traj' in rec: n_traj += 1
    fails = [r for r in results if r['fails']]
    caps  = sum(1 for r in results if r.get('traj') == 'CAPTURE')
    print(f"samples={len(results)} trajectories={n_traj} captures={caps} failing={len(fails)}")
    # worst margins across suite
    keys = set(k for r in results for k in r['margins'])
    worst = {k: min(r['margins'][k] for r in results if k in r['margins']) for k in sorted(keys)}
    for k, v in worst.items(): print(f"  worst {k}: {v:.6g}")
    if fails:
        print("FAILURES:")
        for r in fails[:20]:
            print("  ", r['fails'], "R=", round(r['R'],3), "r=", r['r'], "sf=", r['s_factor'], "U=", [round(u,3) for u in r['U']])
    json.dump(dict(summary=dict(samples=len(results), trajectories=n_traj,
              captures=caps, failures=len(fails)), worst_margins=worst,
              failures=[{k: r[k] for k in ('fails','R','r','s_factor','U')} for r in fails],
              seed=20260721, K=K, eps0=EPS0), open('/home/claude/p02_results.json','w'), indent=1)
    print("wrote /home/claude/p02_results.json")

if __name__ == '__main__':
    main()
