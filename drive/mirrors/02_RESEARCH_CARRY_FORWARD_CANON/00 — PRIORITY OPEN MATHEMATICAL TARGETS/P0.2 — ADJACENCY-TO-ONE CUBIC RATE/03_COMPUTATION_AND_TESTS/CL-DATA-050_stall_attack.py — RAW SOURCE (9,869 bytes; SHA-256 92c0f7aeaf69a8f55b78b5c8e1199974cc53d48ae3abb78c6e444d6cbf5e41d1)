#!/usr/bin/env python3
"""
CL-DATA-050 — Adversarial attack on the stall population (the sharpest
remaining falsifier target per CL-AUD-049 s6):

 (1) STALL RESOLUTION: every window configuration classified STALL at
     Tmax=600 in the CL-AUD-049 protocol (r=0.025 rung, same seed) is
     re-integrated to Tmax=10,000 with tighter tolerances and a smaller
     capture radius, to separate true non-capture from horizon censoring.

 (2) TRUNCATION ROBUSTNESS: the exact-law builder is extended to 22 jets
     (nine through fourth order + six fifth-order + seven sixth-order
     midpoint derivatives, all conditioned jointly on the six pins).  The
     degree-six normalized field F6 = F4 + r^2*grad(P5c) + r^3*grad(P6c)
     is built per sample, where P5c/P6c are the raw quintic/sextic Taylor
     terms MINUS their unique pin correction in span{1,X,Y,X^2,XY,X^3}
     (zeroing value+gradient residuals at S=(1/2,0), M=(-1/2,0)), so both
     fields share the exact equilibria (isolating interior remainder
     dynamics, in the spirit of GP-DER-045 s4).  Every stall config and a
     control set of window CAPTURE configs are re-run under F6; outcome
     flips are counted.

Normalization convention: normalized potential P(X,Y) = r^-3 f(rX,rY),
so the homogeneous degree-k jet term carries r^{k-3} — matching the
quadratic (q/r), cubic (r^0), quartic (r^1) pattern of the GP-DER-047
field and giving the O(r^2 H5) remainder scale of GP-DER-045.
Deterministic; base seed 20260721 reproduces the CL-AUD-049 jet stream.
Author: CL line, 2026-07-21.
"""
import numpy as np, json
from math import sqrt, pi
from scipy.integrate import solve_ivp

b = 1.2
RNG = np.random.default_rng(20260721)

# ---------- exact-law builder, 22 targets ----------
def He(m, t):
    if m == 0: return 1.0
    hm1, h = 1.0, t
    for k in range(1, m):
        hm1, h = h, t*h - k*hm1
    return h
def kder(m, t): return ((-1)**m)*He(m, t)*np.exp(-t*t/2)
def cov_dd(ax, ay, bx, by, dx, dy):
    return ((-1)**(bx+by))*kder(ax+bx, dx)*kder(ay+by, dy)
def raw_pins(h):
    return [(0,0,-h),(1,0,-h),(0,1,-h),(0,0,h),(1,0,h),(0,1,h)]
def Lmat(h):
    T = np.zeros((6,6))
    T[0,3]=T[0,0]=0.5
    T[1,3]=1/(2*h); T[1,0]=-1/(2*h)
    T[2,4]=1/(2*h); T[2,1]=-1/(2*h)
    T[3,5]=T[3,2]=0.5
    T[4,5]=1/(2*h); T[4,2]=-1/(2*h)
    T[5,4]=T[5,1]=1.5/h**2
    T[5,:] += -(3/h**2)*T[1,:]
    return T
T9  = [(0,2),(2,1),(1,2),(0,3),(4,0),(3,1),(2,2),(1,3),(0,4)]
T5s = [(5,0),(4,1),(3,2),(2,3),(1,4),(0,5)]
T6s = [(6,0),(5,1),(4,2),(3,3),(2,4),(1,5),(0,6)]
TARG = T9 + T5s + T6s          # 22 targets
def build_law22(r):
    h = r/2; pins = raw_pins(h); T = Lmat(h)
    G = np.array([[cov_dd(a,bq,c,d,p-q2,0.0) for (c,d,q2) in pins] for (a,bq,p) in pins])
    C = np.array([[cov_dd(ax,ay,c,d,-q2,0.0) for (c,d,q2) in pins] for (ax,ay) in TARG])
    S = np.array([[cov_dd(ax,ay,cx,cy,0.0,0.0) for (cx,cy) in TARG] for (ax,ay) in TARG])
    GL = T@G@T.T; CL_ = C@T.T
    yL = np.array([b-r**3/12, -r**2/6, 0, 0, 0, 2.0])
    m = CL_@np.linalg.solve(GL, yL)
    Sig = S - CL_@np.linalg.solve(GL, CL_.T)
    return m, 0.5*(Sig+Sig.T)

# ---------- fields ----------
from math import factorial
def field4(P, U, r, s):
    X, Y = P
    a,w,z,c40,c31,c22,c13,c04 = U
    P4X = (c40/6)*X*(X*X-0.25)+(c31/6)*(3*X*X-0.25)*Y+(c22/2)*X*Y*Y+(c13/6)*Y**3
    P4Y = (c31/6)*X*(X*X-0.25)+(c22/2)*X*X*Y+(c13/2)*X*Y*Y+(c04/6)*Y**3
    return np.array([X*X-0.25+a*X*Y+(w/2)*Y*Y+r*P4X,
                     s*Y+(a/2)*(X*X-0.25)+w*X*Y+(z/2)*Y*Y+r*P4Y])

def make_pin_corrected_grad(jets, order):
    """Return (gx, gy) callables for the pin-corrected homogeneous term.
    jets: dict multi-index -> value. order: 5 or 6.
    Correction basis span{1, X, Y, X^2, XY, X^3}; conditions: value and
    both gradient components at S=(0.5,0) and M=(-0.5,0)."""
    idxs = T5s if order == 5 else T6s
    def Q(X, Y):
        return sum(jets[a]*X**a[0]*Y**a[1]/(factorial(a[0])*factorial(a[1])) for a in idxs)
    def Qx(X, Y):
        return sum(jets[a]*a[0]*X**max(a[0]-1,0)*Y**a[1]/(factorial(a[0])*factorial(a[1]))
                   for a in idxs if a[0] > 0)
    def Qy(X, Y):
        return sum(jets[a]*a[1]*X**a[0]*Y**max(a[1]-1,0)/(factorial(a[0])*factorial(a[1]))
                   for a in idxs if a[1] > 0)
    # correction c(X,Y) = c0 + c1 X + c2 Y + c3 X^2 + c4 XY + c5 X^3
    def basis_rows(X, Y):
        val  = [1, X, Y, X*X, X*Y, X**3]
        dvx  = [0, 1, 0, 2*X, Y, 3*X*X]
        dvy  = [0, 0, 1, 0, X, 0]
        return val, dvx, dvy
    A = []; rhs = []
    for (Xp, Yp) in [(0.5, 0.0), (-0.5, 0.0)]:
        val, dvx, dvy = basis_rows(Xp, Yp)
        A += [val, dvx, dvy]
        rhs += [Q(Xp, Yp), Qx(Xp, Yp), Qy(Xp, Yp)]
    cvec = np.linalg.solve(np.array(A, float), np.array(rhs, float))
    def gx(X, Y):
        _, dvx, _ = basis_rows(X, Y)
        return Qx(X, Y) - float(np.dot(cvec, dvx))
    def gy(X, Y):
        _, _, dvy = basis_rows(X, Y)
        return Qy(X, Y) - float(np.dot(cvec, dvy))
    return gx, gy

def field6_factory(U22, r):
    U9 = U22[:9]
    j5 = {a: U22[9+i]  for i, a in enumerate(T5s)}
    j6 = {a: U22[15+i] for i, a in enumerate(T6s)}
    g5x, g5y = make_pin_corrected_grad(j5, 5)
    g6x, g6y = make_pin_corrected_grad(j6, 6)
    def f6(P, s):
        base = field4(P, U9[1:], r, s)   # U9[1:] = (a,w,z,c40..c04); q enters via s
        X, Y = P
        return base + np.array([r*r*g5x(X,Y) + r**3*g6x(X,Y),
                                r*r*g5y(X,Y) + r**3*g6y(X,Y)])
    return f6

def classify_gen(rhs, U9tail, r, s, Tmax, cap_rad):
    a,w = U9tail[0], U9tail[1]
    c40, c31, c22 = U9tail[3], U9tail[4], U9tail[5]
    A = 1+r*c40/12; B = a/2+r*c31/12; D = s+w/2+r*c22/8
    M2 = np.array([[A,-B],[-B,D]])
    evals, evecs = np.linalg.eigh(M2)
    if not (evals[0] < 0 < evals[-1]): return 'NOT_FLOW_SADDLE'
    v = evecs[:,-1]
    if v[0] == 0: return 'DEGENERATE'
    xi0 = 1e-6
    P0 = np.array([0.5-xi0, (v[1]/v[0])*xi0])
    sol = solve_ivp(lambda t,P: rhs(P, s), (0, Tmax), P0, method='LSODA',
                    rtol=1e-10, atol=1e-13, max_step=5.0)
    Pe = sol.y[:,-1]
    dM = np.hypot(Pe[0]+0.5, Pe[1])
    if dM < cap_rad: return 'CAPTURE'
    if abs(Pe[0]) > 0.75 or abs(Pe[1]) > 1.0: return 'ESCAPE'
    return 'STALL'

def C1_of(U9tail, r):
    a,w,z,c40,c31,c22,c13,c04 = U9tail
    F = abs(a)/8 + r*abs(c31)/48
    return abs(w)/2 + 1.0 + r*abs(c22)/8 + (abs(z)+r*abs(c13)/2)*F + r*abs(c04)*F*F/2

# ---------- replicate the CL-AUD-049 r=0.025 window scan, collecting configs ----------
r = 0.025
m22, S22 = build_law22(r)
# marginal over the 21 non-q jets (indices 1..21), conditional q
mU, mq = m22[1:], m22[0]
SUU = S22[1:,1:]; SqU = S22[0,1:]; Sqq = S22[0,0]
Areg = np.linalg.solve(SUU, SqU); var_q = Sqq - SqU@Areg; sd = sqrt(var_q)
NU, nq = 300, 36
# NOTE: the 21-dim jet stream differs from CL-AUD-049's 8-dim stream (same seed,
# different dimensionality) — this is a fresh sample of the same law, disclosed.
Us = RNG.multivariate_normal(mU, SUU, size=NU)
mu_qs = mq + (Us-mU)@Areg
stall_configs = []; capture_ctrl = []
for i in range(NU):
    U21 = Us[i]; U9tail = U21[:8]  # (a,w,z,c40,c31,c22,c13,c04)
    mu_q = mu_qs[i]
    a,w = U9tail[0], U9tail[1]; c40,c31,c22 = U9tail[3],U9tail[4],U9tail[5]
    C1 = C1_of(U9tail, r)
    wlo = -1.5*r*C1
    qhi = r*abs(w)/2 + r*r*abs(c22)/8 + 0.02*r
    if qhi <= wlo: continue
    for q in np.linspace(wlo, qhi, nq):
        d11M = -r+r*r*c40/12; d12M = -a*r/2+r*r*c31/12
        dMv = d11M*(q - r*w/2 + r*r*c22/8) - d12M*d12M
        d11S = r+r*r*c40/12; d12S = a*r/2+r*r*c31/12
        dSv = d11S*(q + r*w/2 + r*r*c22/8) - d12S*d12S
        if not ((d11M<0) and (dMv>0) and (dSv<0)): continue
        s = q/r
        out = classify_gen(lambda P, ss: field4(P, U9tail, r, ss), U9tail, r, s,
                           Tmax=600.0, cap_rad=0.05)
        if out == 'STALL':
            stall_configs.append((i, q))
        elif out == 'CAPTURE' and len(capture_ctrl) < 120 and q > -r*C1:
            capture_ctrl.append((i, q))
print(f"collected stalls={len(stall_configs)} capture_controls={len(capture_ctrl)}", flush=True)

# ---------- (1) long-horizon resolution + (2) degree-6 comparison ----------
res = dict(stalls_total=len(stall_configs), resolved_capture=0, resolved_escape=0,
           persistent_stall=0, d6_agree=0, d6_flip_to_capture=0, d6_flip_to_noncap=0,
           ctrl_total=len(capture_ctrl), ctrl_d6_flips=0)
persistent = []
for (i, q) in stall_configs:
    U21 = Us[i]; U9tail = U21[:8]; s = q/r
    U22full = np.concatenate([[q], U21])
    out4 = classify_gen(lambda P, ss: field4(P, U9tail, r, ss), U9tail, r, s,
                        Tmax=10000.0, cap_rad=0.02)
    f6 = field6_factory(U22full, r)
    out6 = classify_gen(lambda P, ss: f6(P, ss), U9tail, r, s, Tmax=10000.0, cap_rad=0.02)
    if out4 == 'CAPTURE': res['resolved_capture'] += 1
    elif out4 == 'ESCAPE': res['resolved_escape'] += 1
    else:
        res['persistent_stall'] += 1
        persistent.append(dict(i=int(i), q=float(q), out4=out4, out6=out6))
    if out6 == out4: res['d6_agree'] += 1
    elif out6 == 'CAPTURE': res['d6_flip_to_capture'] += 1
    else: res['d6_flip_to_noncap'] += 1
for (i, q) in capture_ctrl:
    U21 = Us[i]; U9tail = U21[:8]; s = q/r
    U22full = np.concatenate([[q], U21])
    f6 = field6_factory(U22full, r)
    out6 = classify_gen(lambda P, ss: f6(P, ss), U9tail, r, s, Tmax=2000.0, cap_rad=0.02)
    if out6 != 'CAPTURE': res['ctrl_d6_flips'] += 1
res['persistent_detail'] = persistent[:40]
print(json.dumps(res, indent=1), flush=True)
json.dump(dict(r=r, seed=20260721, results=res,
               note="fresh 21-dim jet stream (same law/seed, different dim than CL-AUD-049); "
                    "F6 = F4 + r^2 grad(P5c) + r^3 grad(P6c), pin-corrected in span{1,X,Y,X^2,XY,X^3}"),
          open('/home/claude/stall_results.json','w'), indent=1)
