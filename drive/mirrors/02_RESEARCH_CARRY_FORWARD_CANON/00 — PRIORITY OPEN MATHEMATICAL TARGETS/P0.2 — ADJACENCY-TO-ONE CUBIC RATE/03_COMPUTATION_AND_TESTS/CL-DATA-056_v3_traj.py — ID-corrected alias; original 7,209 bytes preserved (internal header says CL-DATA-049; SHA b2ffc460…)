#!/usr/bin/env python3
"""
CL-DATA-049 — V3 accessible-r layer: TRAJECTORY-BASED measurement of the
degree-four local model's true nonadjacency rate under the exact typed
determinant-weighted pair-Palm law.

For each rung r: sample jets U from the reconstructed exact finite-r law
(CL-DATA-048 builder, confluent-frame route); for q in the plausible-failure
window (boundary layer around q~0 where the mu=1 strip criterion fails),
integrate the exact degree-four flow from the selected M-ward unstable
branch of S and classify CAPTURE / NONCAPTURE (escape or stall).  Outside
the window (q <= -1.5*r*C1(U)) capture is taken as established: the strip
certificate applies there and CL-AUD-044's 864-configuration battery found
zero counterexamples deep in the certified regime; this assumption is
disclosed and spot-checked with extra trajectories per rung.

Outputs per rung: P_MS(noncapture) with per-sample q-quadrature,
P/r^3, the strip-complement bound for comparison, false-negative rate
(strip-violating q that nevertheless capture), and stall accounting.
Deterministic seed 20260721.  Author: CL line, 2026-07-21.
"""
import numpy as np, json
from math import sqrt, pi
from scipy.integrate import solve_ivp

b = 1.2
RNG = np.random.default_rng(20260721)

# ---------- exact-law builder (identical route to CL-DATA-048) ----------
def He(m, t):
    if m == 0: return 1.0
    hm1, h = 1.0, t
    for k in range(1, m):
        hm1, h = h, t*h - k*hm1
    return h
def kder(m, t): return ((-1)**m)*He(m, t)*np.exp(-t*t/2)
def cov_dd(ax, ay, bx, by, dx, dy):
    return ((-1)**(bx+by))*kder(ax+bx, dx)*kder(ay+by, dy)
def raw_pins(h):
    return [(0,0,-h),(1,0,-h),(0,1,-h),(0,0,h),(1,0,h),(0,1,h)]
def Lmat(h):
    T = np.zeros((6,6)); FM,XM,YM,FS,XS,YS = range(6)
    T[0,FS]=T[0,FM]=0.5
    T[1,FS]=1/(2*h); T[1,FM]=-1/(2*h)
    T[2,XS]=1/(2*h); T[2,XM]=-1/(2*h)
    T[3,YS]=T[3,YM]=0.5
    T[4,YS]=1/(2*h); T[4,YM]=-1/(2*h)
    T[5,XS]=T[5,XM]=1.5/h**2
    T[5,:] += -(3/h**2)*T[1,:]
    return T
TARGETS = [(0,2),(2,1),(1,2),(0,3),(4,0),(3,1),(2,2),(1,3),(0,4)]
def build_law(r):
    h = r/2; pins = raw_pins(h); T = Lmat(h)
    G = np.array([[cov_dd(a,bq,c,d,p-q2,0.0) for (c,d,q2) in pins] for (a,bq,p) in pins])
    C = np.array([[cov_dd(ax,ay,c,d,-q2,0.0) for (c,d,q2) in pins] for (ax,ay) in TARGETS])
    S = np.array([[cov_dd(ax,ay,cx,cy,0.0,0.0) for (cx,cy) in TARGETS] for (ax,ay) in TARGETS])
    GL = T@G@T.T; CL_ = C@T.T
    yL = np.array([b-r**3/12, -r**2/6, 0, 0, 0, 2.0])
    m = CL_@np.linalg.solve(GL, yL)
    Sig = S - CL_@np.linalg.solve(GL, CL_.T)
    return m, 0.5*(Sig+Sig.T)

# ---------- flow ----------
def field(P, U, r, s):
    X, Y = P
    a,w,z,c40,c31,c22,c13,c04 = U
    P4X = (c40/6)*X*(X*X-0.25)+(c31/6)*(3*X*X-0.25)*Y+(c22/2)*X*Y*Y+(c13/6)*Y**3
    P4Y = (c31/6)*X*(X*X-0.25)+(c22/2)*X*X*Y+(c13/2)*X*Y*Y+(c04/6)*Y**3
    return np.array([X*X-0.25+a*X*Y+(w/2)*Y*Y+r*P4X,
                     s*Y+(a/2)*(X*X-0.25)+w*X*Y+(z/2)*Y*Y+r*P4Y])

def classify(U, r, s, Tmax=600.0):
    a,w,z,c40,c31,c22,c13,c04 = U
    A = 1+r*c40/12; B = a/2+r*c31/12; D = s+w/2+r*c22/8
    M2 = np.array([[A,-B],[-B,D]])
    evals, evecs = np.linalg.eigh(M2)
    if not (evals[0] < 0 < evals[-1]):
        return 'NOT_FLOW_SADDLE'
    v = evecs[:,-1]
    if v[0] == 0: return 'DEGENERATE'
    xi0 = 1e-6
    P0 = np.array([0.5-xi0, (v[1]/v[0])*xi0])
    sol = solve_ivp(lambda t,P: field(P,U,r,s), (0,Tmax), P0, method='LSODA',
                    rtol=1e-9, atol=1e-12, max_step=2.0)
    Pe = sol.y[:,-1]
    dM = np.hypot(Pe[0]+0.5, Pe[1])
    if dM < 0.05: return 'CAPTURE'
    if abs(Pe[0]) > 0.75 or abs(Pe[1]) > 1.0: return 'ESCAPE'
    return 'STALL'

def C1_of(U, r):
    a,w,z,c40,c31,c22,c13,c04 = U
    F = abs(a)/8 + r*abs(c31)/48
    return abs(w)/2 + 1.0 + r*abs(c22)/8 + (abs(z)+r*abs(c13)/2)*F + r*abs(c04)*F*F/2

def run_rung(r, NU=300, nq=36, n_spotcheck=40):
    m, S = build_law(r)
    mU, mq = m[1:], m[0]
    SUU = S[1:,1:]; SqU = S[0,1:]; Sqq = S[0,0]
    Areg = np.linalg.solve(SUU, SqU); var_q = Sqq - SqU@Areg; sd = sqrt(var_q)
    Us = RNG.multivariate_normal(mU, SUU, size=NU)
    mu_qs = mq + (Us-mU)@Areg
    num = np.zeros(NU); den = np.zeros(NU)
    fn_viol = 0; fn_cap = 0; stalls = 0; noncaps = 0; trajs = 0
    for i in range(NU):
        U = Us[i]; mu_q = mu_qs[i]
        a,w,z,c40,c31,c22,c13,c04 = U
        C1 = C1_of(U, r)
        wlo = -1.5*r*C1                    # below this: strip-certified capture (assumed, spot-checked)
        # full-density q grid for denominator
        qg = np.linspace(mu_q-8*sd, mu_q+8*sd, 400)
        d11M = -r+r*r*c40/12; d12M = -a*r/2+r*r*c31/12
        dM_ = d11M*(qg - r*w/2 + r*r*c22/8) - d12M*d12M
        d11S = r+r*r*c40/12; d12S = a*r/2+r*r*c31/12
        dS_ = d11S*(qg + r*w/2 + r*r*c22/8) - d12S*d12S
        typed = (d11M<0)&(dM_>0)&(dS_<0)
        Wt = np.abs(dM_*dS_)*typed
        dens = np.exp(-(qg-mu_q)**2/(2*var_q))/(sd*sqrt(2*pi))
        den[i] = np.trapezoid(Wt*dens, qg)
        # window grid for numerator: q in [wlo, typed upper cutoff]
        qhi = r*abs(w)/2 + r*r*abs(c22)/8 + 0.02*r   # generous upper edge of typed region near 0
        if qhi <= wlo: continue
        qw = np.linspace(wlo, qhi, nq)
        contrib = np.zeros(nq)
        for j, q in enumerate(qw):
            dMv = d11M*(q - r*w/2 + r*r*c22/8) - d12M*d12M
            dSv = d11S*(q + r*w/2 + r*r*c22/8) - d12S*d12S
            if not ((d11M<0) and (dMv>0) and (dSv<0)):
                continue
            s = q/r
            out = classify(U, r, s)
            trajs += 1
            if out in ('ESCAPE','STALL','NOT_FLOW_SADDLE','DEGENERATE'):
                noncaps += 1
                if out=='STALL': stalls += 1
                Wv = abs(dMv*dSv)
                dv = np.exp(-(q-mu_q)**2/(2*var_q))/(sd*sqrt(2*pi))
                contrib[j] = Wv*dv
            else:
                if q > -r*C1:  # strip-violating but captured
                    fn_viol += 1; fn_cap += 1
        num[i] = np.trapezoid(contrib, qw)
    # spot-check the certified-region assumption
    sc_fail = 0
    for k in range(n_spotcheck):
        U = Us[k % NU]
        C1 = C1_of(U, r)
        q = -RNG.uniform(2.0, 6.0)*r*C1_of(U, r)
        if classify(U, r, q/r) != 'CAPTURE':
            sc_fail += 1
    P = num.mean()/den.mean()
    return dict(P_noncap=float(P), P_over_r3=float(P/r**3),
                trajectories=trajs, noncaptures=noncaps, stalls=stalls,
                strip_violating_but_captured=fn_cap,
                spotcheck_certified_failures=sc_fail, NU=NU)

results = {}
for r in [0.05, 0.025, 0.0125]:
    results[r] = run_rung(r)
    print(r, results[r], flush=True)
rs = np.array([0.05, 0.025, 0.0125])
Ps = np.array([results[r]['P_noncap'] for r in rs])
slope = float(np.polyfit(np.log(rs), np.log(np.maximum(Ps,1e-300)), 1)[0]) if np.all(Ps>0) else None
out = dict(rungs={str(k): v for k, v in results.items()}, loglog_slope=slope,
           seed=20260721, b=b,
           note="degree-four local model; certified region (q<=-1.5 r C1) assumed CAPTURE per strip theorem + CL-AUD-044, spot-checked")
print(json.dumps(out, indent=1))
json.dump(out, open('/home/claude/v3_results.json','w'), indent=1)
