#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CL EC-019 T2 CLEAN-ROOM VERIFIER  v1.1  (Route-B degree-four capture margins)
============================================================================
Independent re-implementation derived SOLELY from GP-SPEC-166-v1.0 and the
routing packet GP-REQ-172-v1.1.

Author line : CL -- Anthropic Claude (model line claude-opus-4-8), Cowork session.

DIFFERENCE FROM v1.0 (cl_ec019_t2_verifier.py, frozen 2026-07-24T20:10:16Z):
  Only the square-root enclosure is hardened.  v1.0 used Decimal.sqrt under
  ROUND_FLOOR / ROUND_CEILING contexts.  In CPython, Decimal.sqrt() is
  correctly rounded to NEAREST and does NOT honour the context's directed
  rounding mode, so the v1.0 sqrt endpoints were nearest-rounded (a <=~1e-200
  ulp-level non-rigor that cannot affect any of the nineteen signs, whose
  smallest lower bound is ~7.485e-3, and does not touch the nine exact-rational
  margins at all).  v1.1 replaces the sqrt with a PROVABLY OUTWARD pure-integer
  enclosure using math.isqrt: for a nonnegative rational x and scale S=10^N,
  L = isqrt( floor(x * S^2) ) gives  L/S <= sqrt(x) <= (L+1)/S  with the exact
  rational check  (L/S)^2 <= x <= ((L+1)/S)^2  asserted at runtime.  No
  constant, domain, formula, or precision policy is otherwise changed.  This is
  a rigor hardening, not a tuning: every displayed 60-digit margin is unchanged.

Method: EXACT rational (fractions.Fraction) interval arithmetic for the entire
polynomial part -- zero rounding error there.  The only irrational quantities,
sqrt(2) inside mu and rho = 2*sqrt(sigma^2+W^2), get the provably-outward
integer-isqrt rational enclosure above.  No third-party library is used.
Whole interval boxes are enclosed (never point-sampled); even powers of a
zero-crossing interval start their lower bound at 0.  Positivity is decided by
an EXACT rational sign test; displayed decimals are rounded OUTWARD.
"""

from fractions import Fraction as Fr
from decimal import Decimal, Context, ROUND_FLOOR, ROUND_CEILING
from math import isqrt
import json

# ----------------------------------------------------------------------
# Provably-outward sqrt on exact rationals (pure integer; no Decimal.sqrt).
# Returns (lo, hi) rationals with  lo^2 <= fr <= hi^2  (checked exactly).
# ----------------------------------------------------------------------
def sqrt_bounds(fr, digits):
    assert fr >= 0
    S = 10 ** digits
    m = (fr.numerator * S * S) // fr.denominator      # floor(fr * S^2)
    L = isqrt(m)                                       # floor(sqrt(m))
    lo = Fr(L, S)
    hi = Fr(L + 1, S)
    assert lo * lo <= fr <= hi * hi                    # exact rigor guarantee
    return lo, hi

# ----------------------------------------------------------------------
# Interval with exact rational endpoints.
# ----------------------------------------------------------------------
class Iv:
    __slots__ = ("lo", "hi")

    def __init__(self, lo, hi=None):
        if hi is None:
            hi = lo
        lo = Fr(lo); hi = Fr(hi)
        if lo > hi:
            raise ValueError("empty interval [%s,%s]" % (lo, hi))
        self.lo = lo; self.hi = hi

    @staticmethod
    def _c(x):
        return x if isinstance(x, Iv) else Iv(Fr(x))

    def __add__(self, o):
        o = Iv._c(o); return Iv(self.lo + o.lo, self.hi + o.hi)
    __radd__ = __add__

    def __sub__(self, o):
        o = Iv._c(o); return Iv(self.lo - o.hi, self.hi - o.lo)
    def __rsub__(self, o):
        return Iv._c(o).__sub__(self)

    def __mul__(self, o):
        o = Iv._c(o)
        p = (self.lo * o.lo, self.lo * o.hi, self.hi * o.lo, self.hi * o.hi)
        return Iv(min(p), max(p))
    __rmul__ = __mul__

    def __truediv__(self, o):
        o = Iv._c(o)
        if o.lo <= 0 <= o.hi:
            raise ZeroDivisionError("divisor straddles 0: [%s,%s]" % (o.lo, o.hi))
        q = (self.lo / o.lo, self.lo / o.hi, self.hi / o.lo, self.hi / o.hi)
        return Iv(min(q), max(q))
    def __rtruediv__(self, o):
        return Iv._c(o).__truediv__(self)

    def __neg__(self):
        return Iv(-self.hi, -self.lo)

    def __repr__(self):
        return "Iv(%s, %s)" % (self.lo, self.hi)


def ipow(x, n):
    if n == 1:
        return x
    if n % 2 == 1:
        return Iv(x.lo ** n, x.hi ** n)
    if x.lo >= 0:
        return Iv(x.lo ** n, x.hi ** n)
    if x.hi <= 0:
        return Iv(x.hi ** n, x.lo ** n)
    return Iv(Fr(0), max(x.lo ** n, x.hi ** n))


def isq(x):
    return ipow(x, 2)


def iabs(x):
    if x.lo >= 0:
        return Iv(x.lo, x.hi)
    if x.hi <= 0:
        return Iv(-x.hi, -x.lo)
    return Iv(Fr(0), max(-x.lo, x.hi))


def supabs(x):
    return max(abs(x.lo), abs(x.hi))


def isqrt_iv(x, digits):
    assert x.lo >= 0
    lo, _ = sqrt_bounds(x.lo, digits)
    _, hi = sqrt_bounds(x.hi, digits)
    return Iv(lo, hi)


# ----------------------------------------------------------------------
# Fixed constants and primary parameter box (Section 3).
# ----------------------------------------------------------------------
R      = Fr(1, 20)
SIGMA  = Fr(1, 10)
KAPPA0 = Fr(1, 100)

PRIMARY = {
    "a":   (Fr(25, 10000), Fr(1, 10000)),
    "w":   (Fr(0),         Fr(1, 1000)),
    "z":   (Fr(1),         Fr(1, 100)),
    "s":   (Fr(-1),        Fr(2, 100)),
    "c40": (Fr(0),         Fr(1, 100)),
    "c31": (Fr(0),         Fr(1, 100)),
    "c22": (Fr(0),         Fr(1, 100)),
    "c13": (Fr(0),         Fr(1, 100)),
    "c04": (Fr(0),         Fr(1, 100)),
}
PORDER = ["a", "w", "z", "s", "c40", "c31", "c22", "c13", "c04"]


def make_box(centres_radii):
    box, radii = {}, {}
    for name, (c, rad) in centres_radii.items():
        radii[name] = rad
        box[name] = Iv(c - rad, c + rad)
    return box, radii


def full_dim_validator(radii):
    fails = [k for k in PORDER if (k not in radii) or (radii[k] <= 0)]
    return (len(fails) == 0), fails


# ----------------------------------------------------------------------
# Flow, Jacobian/Hessian (Section 4).
# ----------------------------------------------------------------------
def F_x(X, Y, b):
    a, w = b["a"], b["w"]
    c40, c31, c22, c13 = b["c40"], b["c31"], b["c22"], b["c13"]
    return (isq(X) - Fr(1, 4) + a * X * Y + w * isq(Y) / 2
            + R * (c40 * (ipow(X, 3) - X / 4) / 6
                   + c31 * (3 * isq(X) - Fr(1, 4)) * Y / 6
                   + c22 * X * isq(Y) / 2
                   + c13 * ipow(Y, 3) / 6))


def F_y(X, Y, b):
    a, w, z, s = b["a"], b["w"], b["z"], b["s"]
    c31, c22, c13, c04 = b["c31"], b["c22"], b["c13"], b["c04"]
    return (a * (isq(X) - Fr(1, 4)) / 2 + s * Y + w * X * Y + z * isq(Y) / 2
            + R * (c31 * (ipow(X, 3) - X / 4) / 6
                   + c22 * isq(X) * Y / 2
                   + c13 * X * isq(Y) / 2
                   + c04 * ipow(Y, 3) / 6))


def J11(X, Y, b):
    a, c40, c31, c22 = b["a"], b["c40"], b["c31"], b["c22"]
    return 2 * X + a * Y + R * (c40 * (3 * isq(X) - Fr(1, 4)) / 6
                                + c31 * X * Y + c22 * isq(Y) / 2)


def J12(X, Y, b):
    a, w, c31, c22, c13 = b["a"], b["w"], b["c31"], b["c22"], b["c13"]
    return a * X + w * Y + R * (c31 * (3 * isq(X) - Fr(1, 4)) / 6
                                + c22 * X * Y + c13 * isq(Y) / 2)


def J22(X, Y, b):
    w, z, s, c22, c13, c04 = b["w"], b["z"], b["s"], b["c22"], b["c13"], b["c04"]
    return s + w * X + z * Y + R * (c22 * isq(X) / 2 + c13 * X * Y + c04 * isq(Y) / 2)


def Q_x(xi, t, b):
    a, w = b["a"], b["w"]
    c40, c31, c22, c13 = b["c40"], b["c31"], b["c22"], b["c13"]
    num = (12 * a * t * xi - 6 * a * t
           - 2 * c13 * R * ipow(t, 3) * isq(xi)
           + 6 * c22 * R * isq(t) * isq(xi) - 3 * c22 * R * isq(t) * xi
           - 6 * c31 * R * t * isq(xi) + 6 * c31 * R * t * xi - c31 * R * t
           + 2 * c40 * R * isq(xi) - 3 * c40 * R * xi + c40 * R
           - 6 * isq(t) * w * xi - 12 * xi + 12)
    return num / 12


def Q_y(xi, t, b):
    a, w, z, s = b["a"], b["w"], b["z"], b["s"]
    c04, c13, c22, c31 = b["c04"], b["c13"], b["c22"], b["c31"]
    num = (12 * a * xi - 12 * a
           + 4 * c04 * R * ipow(t, 3) * isq(xi)
           - 12 * c13 * R * isq(t) * isq(xi) + 6 * c13 * R * isq(t) * xi
           + 12 * c22 * R * t * isq(xi) - 12 * c22 * R * t * xi + 3 * c22 * R * t
           - 4 * c31 * R * isq(xi) + 6 * c31 * R * xi - 2 * c31 * R
           + 24 * s * t + 12 * isq(t) * xi * z - 24 * t * w * xi + 12 * t * w)
    return num / 24


def compute(box, kappa, digits):
    b = box
    a, w, z, s = b["a"], b["w"], b["z"], b["s"]
    c40, c31, c22, c13, c04 = (b["c40"], b["c31"], b["c22"], b["c13"], b["c04"])

    sqrt2 = isqrt_iv(Iv(2, 2), digits)
    mu = Iv(1, 1) / (40 * sqrt2)

    out = {}
    Fq = iabs(a) / 8 + R * iabs(c31) / 48
    Aq = (iabs(z) + R * iabs(c13) / 2) * Fq
    Bq = R * iabs(c04) * isq(Fq) / 2
    Cq = iabs(w) / 2 + mu + R * iabs(c22) / 8 + Aq / mu + Bq / isq(mu)
    W = Fq / mu
    out["m_threshold"] = ((-s) - Cq).lo

    A_S = 1 + R * c40 / 12
    B_S = a / 2 + R * c31 / 12
    D_S = s + w / 2 + R * c22 / 8
    det_S = A_S * D_S - isq(B_S)
    A_M = -1 + R * c40 / 12
    B_M = (-a) / 2 + R * c31 / 12
    D_M = s - w / 2 + R * c22 / 8
    det_M = A_M * D_M - isq(B_M)
    g = A_S - D_S
    gate_ok = (g.lo > 0)
    tau_upper = supabs(B_S) / g.lo if gate_ok else None

    out["m_saddle_det"] = -det_S.hi
    out["m_max_A"] = -A_M.hi
    out["m_max_D"] = -D_M.hi
    out["m_max_det"] = det_M.lo
    out["m_axial"] = g.lo
    out["m_cone_slope"] = (kappa - 2 * tau_upper) if gate_ok else Fr(-1)

    xi = Iv(0, SIGMA)
    t_iv = Iv(-kappa, kappa)
    kp = Iv(kappa, kappa)
    kn = Iv(-kappa, -kappa)
    out["m_cone_axis"] = Q_x(xi, t_iv, b).lo
    out["m_cone_upper"] = (kappa * Q_x(xi, kp, b) - Q_y(xi, kp, b)).lo
    out["m_cone_lower"] = (kappa * Q_x(xi, kn, b) + Q_y(xi, kn, b)).lo
    out["m_handoff"] = W.lo / 2 - kappa * SIGMA

    X_c = Iv(Fr(-1, 2) + SIGMA, Fr(1, 2) - SIGMA)
    Y_top = W
    Y_bottom = Iv(-W.hi, -W.lo)
    Y_strip = Iv(-W.hi, W.hi)
    out["m_strip_top"] = (-F_y(X_c, Y_top, b)).lo
    out["m_strip_bottom"] = F_y(X_c, Y_bottom, b).lo
    out["m_central_drift"] = (-F_x(X_c, Y_strip, b)).lo
    out["m_transverse_contraction"] = -J22(X_c, Y_strip, b).hi

    rho = 2 * isqrt_iv(isq(Iv(SIGMA, SIGMA)) + isq(W), digits)
    rho_u = rho.hi
    X_cap = Iv(Fr(-1, 2) - rho_u, Fr(-1, 2) + rho_u)
    Y_cap = Iv(-rho_u, rho_u)
    j11 = J11(X_cap, Y_cap, b)
    j12 = J12(X_cap, Y_cap, b)
    j22 = J22(X_cap, Y_cap, b)
    offdiag = supabs(j12)
    out["m_chart_X"] = Fr(3, 4) - (Fr(1, 2) + rho_u)
    out["m_chart_Y"] = Fr(1) - rho_u
    out["m_gersh_1"] = (-j11.hi) - offdiag
    out["m_gersh_2"] = (-j22.hi) - offdiag

    aux = {"W_lo": W.lo, "W_hi": W.hi, "rho_lo": rho.lo, "rho_hi": rho.hi,
           "tau_upper": tau_upper, "cone_slope_gate_ok": gate_ok,
           "mu_lo": mu.lo, "mu_hi": mu.hi}
    return out, aux


MARGIN_NAMES = [
    "m_threshold", "m_saddle_det", "m_max_A", "m_max_D", "m_max_det",
    "m_axial", "m_cone_slope", "m_cone_axis", "m_cone_upper", "m_cone_lower",
    "m_handoff", "m_strip_top", "m_strip_bottom", "m_central_drift",
    "m_transverse_contraction", "m_chart_X", "m_chart_Y", "m_gersh_1", "m_gersh_2",
]
assert len(MARGIN_NAMES) == 19


def dfloor(fr, d=60):
    return str(Context(prec=d, rounding=ROUND_FLOOR).divide(
        Decimal(fr.numerator), Decimal(fr.denominator)))


def dceil(fr, d=60):
    return str(Context(prec=d, rounding=ROUND_CEILING).divide(
        Decimal(fr.numerator), Decimal(fr.denominator)))


def run_controls(digits):
    results = {}
    cr = dict(PRIMARY); cr["c04"] = (PRIMARY["c04"][0], Fr(0))
    _, radii = make_box(cr); ok, fails = full_dim_validator(radii)
    results["NC1_zero_width"] = {"required": "FULL_DIMENSIONAL_BOX_FAIL",
        "validator_ok": ok, "failing_radii": fails,
        "fired": (not ok) and ("c04" in fails)}

    cr = dict(PRIMARY); cr["c40"] = (PRIMARY["c40"][0], Fr(500))
    box, _ = make_box(cr); m, _ = compute(box, KAPPA0, digits)
    results["NC2_endpoint_typing"] = {"required": "m_saddle_det<=0 OR m_max_det<=0",
        "m_saddle_det": dfloor(m["m_saddle_det"]), "m_max_det": dfloor(m["m_max_det"]),
        "fired": bool((m["m_saddle_det"] <= 0) or (m["m_max_det"] <= 0))}

    cr = dict(PRIMARY); cr["s"] = (PRIMARY["s"][0], Fr(11, 10))
    box, _ = make_box(cr); m, _ = compute(box, KAPPA0, digits)
    results["NC3_threshold"] = {"required": "m_threshold<=0",
        "m_threshold": dfloor(m["m_threshold"]), "fired": bool(m["m_threshold"] <= 0)}

    box, _ = make_box(PRIMARY); m, _ = compute(box, Fr(5, 10000), digits)
    results["NC4_cone_narrow"] = {"required": "m_cone_slope<=0",
        "m_cone_slope": dfloor(m["m_cone_slope"]), "fired": bool(m["m_cone_slope"] <= 0)}

    cr = dict(PRIMARY); cr["a"] = (PRIMARY["a"][0], Fr(1, 2))
    box, _ = make_box(cr); m, _ = compute(box, KAPPA0, digits)
    results["NC5_capture_chart"] = {"required": "m_chart_X<=0 OR m_gersh_1<=0",
        "m_chart_X": dfloor(m["m_chart_X"]), "m_gersh_1": dfloor(m["m_gersh_1"]),
        "fired": bool((m["m_chart_X"] <= 0) or (m["m_gersh_1"] <= 0))}
    return results


def run_mutations():
    res = {}
    for name in PORDER:
        cr = dict(PRIMARY); cr[name] = (PRIMARY[name][0], Fr(0))
        _, radii = make_box(cr); ok, fails = full_dim_validator(radii)
        res[name] = {"validator_ok": ok, "rejected": (not ok) and (name in fails)}
    return res


LADDER = [50, 100, 200]
CANON_DIGITS = 200


def main():
    box, radii = make_box(PRIMARY)
    fd_ok, fd_fail = full_dim_validator(radii)

    ladder = {}
    for d in LADDER:
        m, _ = compute(box, KAPPA0, d)
        ladder[str(d)] = {name: (m[name] > 0) for name in MARGIN_NAMES}
    sign_stable = all(ladder[str(LADDER[0])][n] == ladder[str(d)][n]
                      for d in LADDER for n in MARGIN_NAMES)

    m, aux = compute(box, KAPPA0, CANON_DIGITS)
    margins = {n: {"lower_bound": dfloor(m[n]), "positive": bool(m[n] > 0)}
               for n in MARGIN_NAMES}
    all_pos = all(margins[n]["positive"] for n in MARGIN_NAMES)
    controls = run_controls(CANON_DIGITS)
    mutations = run_mutations()
    controls_fire = all(c["fired"] for c in controls.values())
    mutations_ok = all(mm["rejected"] for mm in mutations.values())

    verdict = ("T2 -- PASS" if (fd_ok and all_pos and controls_fire
               and mutations_ok and sign_stable) else "T2 -- FAIL")

    result = {
        "artifact_class": "CL clean-room independent verification of EC-019 T2 (v1.1 hardened sqrt)",
        "derived_only_from": "GP-SPEC-166-v1.0 + GP-REQ-172-v1.1",
        "method": "exact-rational interval arithmetic; provably-outward integer-isqrt sqrt enclosure",
        "canonical_sqrt_digits": CANON_DIGITS,
        "precision_ladder_digits": LADDER,
        "full_dimensionality": {"primary_ok": fd_ok, "failing": fd_fail},
        "param_box": {k: {"lo": dfloor(box[k].lo), "hi": dceil(box[k].hi)} for k in PORDER},
        "aux": {"W": {"lo": dfloor(aux["W_lo"]), "hi": dceil(aux["W_hi"])},
                "rho": {"lo": dfloor(aux["rho_lo"]), "hi": dceil(aux["rho_hi"])},
                "mu": {"lo": dfloor(aux["mu_lo"]), "hi": dceil(aux["mu_hi"])},
                "tau_upper": dceil(aux["tau_upper"]),
                "cone_slope_gate_ok": aux["cone_slope_gate_ok"]},
        "margins": margins,
        "all_nineteen_positive": all_pos,
        "sign_stable_across_ladder": sign_stable,
        "ladder_signs": ladder,
        "negative_controls": controls,
        "all_controls_fire": controls_fire,
        "zero_radius_mutations": mutations,
        "all_mutations_rejected": mutations_ok,
        "verdict": verdict,
    }
    blob = json.dumps(result, sort_keys=True, separators=(",", ":"))
    with open("cl_result_v11.json", "w") as fh:
        fh.write(blob)
    with open("cl_result_v11_pretty.json", "w") as fh:
        json.dump(result, fh, sort_keys=True, indent=2)
    print(blob)


if __name__ == "__main__":
    main()
