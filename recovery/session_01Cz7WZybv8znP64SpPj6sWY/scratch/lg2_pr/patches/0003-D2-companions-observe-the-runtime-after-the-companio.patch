  'companions/d2_square_schur_20261006/D2SquareSchur.lean':'4855c92d55254969e1de7f8cf8dec2bdc027cf69'}
@@ -110,6 +110,35 @@ def emit(out):
     for label,statement in FALSE_STATEMENTS.items():
         (out/(label+'.lean')).write_text('import D2AtomIntegral\nexample : '+statement+' := by\n  norm_num\n')
 
+LEAN_VERSION=re.compile(r'Lean \(version 4\.34\.1, [^()\r\n]+, commit 5045d0056413266e57c625dcd7c365b10e377c52, Release\)')
+
+
+def final_runtime(out,core,lock):
+    """The companion's own Lean runs follow the core gate, so the core's observations do not cover them.
+    replay.sh observes the runtime and the dependencies again after the companion's last Lean execution;
+    both must equal the core gate's equal preflight and final observations, the exact release and the lock."""
+    version=core.get('lean_version')
+    require(isinstance(version,str) and LEAN_VERSION.fullmatch(version) is not None,'core receipt runtime is not the pinned release')
+    obs=core.get('observations')
+    require(isinstance(obs,dict) and set(obs)=={'preflight','final'} and isinstance(obs['final'],dict) and obs['final']==obs['preflight'],
+            'core receipt lacks equal preflight and final observations')
+    require(obs['final'].get('lean_version')==version and obs['final'].get('dependency_revisions')==lock
+            and obs['final'].get('dependency_worktrees')=='CLEAN','core final observation differs from the lock')
+    for name in ('toolchain.log','toolchain-final.log'):
+        require((out/name).is_file() and (out/name).read_text()==version+'\n','companion runtime differs from the core gate: '+name)
+    require((out/'packages-final.log').is_file(),'missing final dependency observation')
+    seen={}
+    for line in (out/'packages-final.log').read_text().splitlines():
+        parts=line.split(' ')
+        require(len(parts)==3 and parts[0] not in seen,'malformed final dependency record')
+        seen[parts[0]]=(parts[1],parts[2])
+    require(set(seen)==set(lock),'final dependency set differs from the lock')
+    for name,(head,state) in sorted(seen.items()):
+        require(head==lock[name],'final dependency HEAD differs from the lock: '+name)
+        require(state=='clean','final dependency worktree is not clean: '+name)
+    return {'lean_version':version,'dependency_revisions':dict(sorted(lock.items())),'dependency_worktrees':'CLEAN'}
+
+
 def finish(out):
     current=source();require(strict((out/'source.json').read_bytes())==current,'source changed during execution')
     ax=core_gate().audit_axioms((out/'axioms.log').read_text(),list(TARGETS))
@@ -122,7 +151,8 @@ def finish(out):
     raw=(ROOT/'formal/.lake/formal-evidence/receipt.json').read_bytes();core=strict(raw)
     require(core['checked_commit']==current['checked_commit'] and core['manifest_sha256']==CORE_MANIFEST,'core identity')
     require(core['formalization_status']=='kernel-checked','no core kernel receipt')
-    result={**current,'axioms':ax,'theorem_count':6,'definition_count':0,'core_receipt_sha256':sha(raw),
+    final=final_runtime(out,core,strict((ROOT/'formal/manifest.json').read_bytes())['dependency_revisions'])
+    result={**current,'axioms':ax,'theorem_count':6,'definition_count':0,'core_receipt_sha256':sha(raw),'final_observation':final,
        'formalization_status':'kernel-checked','alignment_status':'PENDING_INDEPENDENT_REVIEW',
        'scientific_acceptance':False,'log_sha256':{p.name:sha(p.read_bytes()) for p in sorted(out.iterdir()) if p.is_file()}}
     (out/'receipt.json').write_text(json.dumps(result,sort_keys=True,indent=2)+'\n')
diff --git a/companions/d2_atom_integral_20261006/replay.sh b/companions/d2_atom_integral_20261006/replay.sh
index a4247be..7dcfcf0 100644
--- a/companions/d2_atom_integral_20261006/replay.sh
+++ b/companions/d2_atom_integral_20261006/replay.sh
@@ -46,6 +46,16 @@ for control in RejectOverlappingEvents RejectNonProbabilityGap RejectZeroRadiusS
   printf '%s\n' "$code" >"$ATOM_OUT/$control.status"
   python3 -B -S "$ATOM_SIDE/check.py" negative "$ATOM_OUT/$control.log" --control "$control" --status "$code"
 done
+# Final observation after the companion's last Lean execution: the core gate observed the runtime
+# before these runs, so it is observed again here, and `check.py finish` requires it unchanged.
+lean --version > "$ATOM_OUT/toolchain-final.log"
+: > "$ATOM_OUT/packages-final.log"
+for pkg in "$PWD"/.lake/packages/*/; do
+  head="$(git -C "$pkg" rev-parse HEAD)"
+  status="$(git -C "$pkg" status --porcelain --untracked-files=normal)"
+  if [ -z "$status" ]; then state=clean; else state=dirty; fi
+  printf '%s %s %s\n' "$(basename "$pkg")" "$head" "$state" >> "$ATOM_OUT/packages-final.log"
+done
 INNER
 cd "$ROOT"
 python3 -B -S "$SIDE/check.py" finish "$OUT"
diff --git a/companions/d2_atom_integral_20261006/test_check.py b/companions/d2_atom_integral_20261006/test_check.py
index cd9a642..efa3793 100644
--- a/companions/d2_atom_integral_20261006/test_check.py
+++ b/companions/d2_atom_integral_20261006/test_check.py
@@ -98,4 +98,56 @@ class AtomIntegralTests(unittest.TestCase):
         self.assertNotIn('continue-on-error',workflow)
         self.assertNotIn('linter.unnecessarySeqFocus false',shell)
 
+
+class FinalRuntimeTests(unittest.TestCase):
+    """The companion's runtime is re-observed after its own last Lean run; earlier core evidence does not cover it."""
+    RELEASE='Lean (version 4.34.1, x86_64-unknown-linux-gnu, commit 5045d0056413266e57c625dcd7c365b10e377c52, Release)'
+
+    def setUp(self):
+        spec=importlib.util.spec_from_file_location('final_runtime_check_d2_atom_i',SIDE/'check.py')
+        self.c=importlib.util.module_from_spec(spec);spec.loader.exec_module(self.c)
+        tmp=tempfile.TemporaryDirectory();self.addCleanup(tmp.cleanup);self.out=Path(tmp.name)
+        self.lock={'mathlib':'d'*40,'batteries':'e'*40}
+        observed={'lean_version':self.RELEASE,'dependency_revisions':dict(self.lock),'dependency_worktrees':'CLEAN','manifest_sha256':'a'*64}
+        self.core={'lean_version':self.RELEASE,'observations':{'preflight':dict(observed),'final':dict(observed)}}
+        for name in ('toolchain.log','toolchain-final.log'):(self.out/name).write_text(self.RELEASE+'\n')
+        self.packages({n:(h,'clean') for n,h in self.lock.items()})
+
+    def packages(self,rows):
+        (self.out/'packages-final.log').write_text(''.join(n+' '+h+' '+s+'\n' for n,(h,s) in rows.items()))
+
+    def refuse(self,message):
+        with self.assertRaisesRegex(ValueError,message):self.c.final_runtime(self.out,self.core,self.lock)
+
+    def test_final_observation_equal_to_core_passes(self):
+        self.assertEqual(self.c.final_runtime(self.out,self.core,self.lock)['dependency_worktrees'],'CLEAN')
+
+    def test_same_semver_other_commit_or_build_refused(self):
+        for text in (self.RELEASE.replace('5045d0056413266e57c625dcd7c365b10e377c52','0'*40),self.RELEASE.replace(', Release)',', Debug)')):
+            with self.subTest(text=text):
+                (self.out/'toolchain-final.log').write_text(text+'\n');self.refuse('differs from the core gate')
+
+    def test_runtime_changed_after_core_gate_refused(self):
+        other=self.RELEASE.replace('x86_64-unknown-linux-gnu','aarch64-unknown-linux-gnu')
+        (self.out/'toolchain-final.log').write_text(other+'\n');self.refuse('differs from the core gate: toolchain-final.log')
+
+    def test_dependency_moved_or_dirtied_after_core_gate_refused(self):
+        self.packages({'mathlib':('f'*40,'clean'),'batteries':('e'*40,'clean')});self.refuse('HEAD differs')
+        self.packages({'mathlib':('d'*40,'dirty'),'batteries':('e'*40,'clean')});self.refuse('not clean')
+        self.packages({'mathlib':('d'*40,'clean')});self.refuse('set differs')
+
+    def test_missing_final_observation_refused(self):
+        (self.out/'packages-final.log').unlink();self.refuse('missing final dependency observation')
+        self.packages({n:(h,'clean') for n,h in self.lock.items()});(self.out/'toolchain-final.log').unlink();self.refuse('toolchain-final.log')
+
+    def test_core_receipt_without_equal_observations_refused(self):
+        self.core.pop('observations');self.refuse('lacks equal preflight and final')
+
+    def test_replay_observes_after_the_last_lean_run_and_finish_requires_it(self):
+        replay=(SIDE/'replay.sh').read_text();inner=replay[:replay.index('\nINNER\n')]
+        self.assertGreater(inner.index('toolchain-final.log'),inner.rindex('lean -DwarningAsError=true'))
+        self.assertGreater(inner.index('packages-final.log'),inner.rindex('lean -DwarningAsError=true'))
+        source=(SIDE/'check.py').read_text();body=source[source.index('def finish(out):'):source.index('def main(')]
+        self.assertIn('final_runtime(out,',body)
+
 if __name__=='__main__':unittest.main(verbosity=2)
