  (hL : @LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) L)
  (g : TorusFiltration.torus_E d → Real) (hg : TorusFiltration.torus_isPeriodic d L g) (M : TorusFiltration.torus_E d) :
  Iff (∀ (y : TorusFiltration.torus_E d), @LE.le Real Real.instLE (g y) (g M))
