  (self : PinnedLawInterface2 d L Ω) (r b k : ℝ) (R : OrthonormalBasis (Fin d) ℝ (E d)) (ω : Ω),
  self.W r b k R ω = typedWeight d r R (self.F ω)
@PinnedLawInterface2.Z_floor : ∀ {d : ℕ} [inst : NeZero d] {L : ℝ} {Ω : Type} [inst_1 : MeasurableSpace Ω]
  (self : PinnedLawInterface2 d L Ω) (bLo bHi kLo kHi : ℝ),
