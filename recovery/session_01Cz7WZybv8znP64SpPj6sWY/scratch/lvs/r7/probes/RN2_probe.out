typedWeight : (d : ℕ) → [NeZero d] → ℝ → OrthonormalBasis (Fin d) ℝ (E d) → (E d → ℝ) → ℝ
@PinnedLawInterface2.Q_regression : ∀ {d : ℕ} [inst : NeZero d] {L : ℝ} {Ω : Type} [inst_1 : MeasurableSpace Ω]
  (self : PinnedLawInterface2 d L Ω) (r b k : ℝ) (R : OrthonormalBasis (Fin d) ℝ (E d)),
  0 < r →
    r < L →
      ∀ (m : ℕ) (x : Fin m → E d),
