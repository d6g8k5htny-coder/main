def UniversalLaw.Spec.Side24.TraceMoments : UniversalLaw.Spec.Side24.ConeMomentInterface → Prop :=
fun I =>
  ∫ (ω : I.Ω), I.s ω ^ 2 ∂I.P = 5 / 3 ∧
    ∫ (ω : I.Ω), I.s ω ^ 4 ∂I.P = 25 / 3 ∧ ∫ (ω : I.Ω), Real.exp (-I.s ω ^ 2 / 2) ∂I.P = √(3 / 8)
