UniversalLaw.Proofs.Side24Analysis.thetaSummable : ∀ (d : ℕ), UniversalLaw.Spec.Side24.ThetaSummable d
def UniversalLaw.Spec.Side24.ThetaSummable : ℕ → Prop :=
fun d =>
