UniversalLaw.Proofs.RNCluster.rareClusterPoissonObstructionO : ∀ (μ : ℝ → ℕ → ℝ) (a A : ℝ),
  UniversalLaw.Spec.RN.RareClusterPoissonObstructionO μ a A
UniversalLaw.Proofs.RNCluster.rareClusterPoissonObstructionO : ∀ (μ : Real → Nat → Real) (a A : Real),
  UniversalLaw.Spec.RN.RareClusterPoissonObstructionO μ a A
def UniversalLaw.Spec.RN.RareClusterPoissonObstructionO : (ℝ → ℕ → ℝ) → ℝ → ℝ → Prop :=
fun μ a A =>
  0 < a →
    (∃ r0,
        0 < r0 ∧
          ∀ (r : ℝ),
            0 < r →
              r ≤ r0 →
                (∀ (n : ℕ), 0 ≤ μ r n) ∧
                  Summable (μ r) ∧
                    ∑' (n : ℕ), μ r n = 1 ∧
                      (Summable fun n => ↑n * μ r n) ∧
                        ∑' (n : ℕ), ↑n * μ r n ≤ A * r ^ 3 ∧ a * r ^ 3 ≤ 1 - μ r 0 - μ r 1) →
      ∃ rStar,
        0 < rStar ∧
          ∀ (r : ℝ),
            0 < r →
              r ≤ rStar →
                (∀ (lam : ℝ),
                    0 ≤ lam → a / 2 * r ^ 3 ≤ UniversalLaw.Spec.RN.pmfTV (μ r) (UniversalLaw.Spec.RN.poissonPMF lam)) ∧
                  ∃ lam, 0 ≤ lam ∧ UniversalLaw.Spec.RN.pmfTV (μ r) (UniversalLaw.Spec.RN.poissonPMF lam) ≤ A * r ^ 3
def UniversalLaw.Spec.RN.pmfTV : (ℕ → ℝ) → (ℕ → ℝ) → ℝ :=
fun μ ν => 1 / 2 * ∑' (n : ℕ), |μ n - ν n|
def UniversalLaw.Spec.RN.poissonPMF : ℝ → ℕ → ℝ :=
fun lam n => Real.exp (-lam) * lam ^ n / ↑n.factorial
