URCES.json'])\n          if present != expected_names:\n              raise ValueError('packet tree differs from manifest: ' + repr(present))\n          for entry in manifest['files']:\n              path = root / entry['path']\n              if path.is_symlink():\n                  raise ValueError('symlink: ' + entry['path'])\n              data = path.read_bytes()\n              if len(data) != entry['bytes'] or hashlib.sha256(data).hexdigest() != entry['sha256']:\n                  raise ValueError('packet file identity mismatch: ' + entry['path'])\n          for entry in manifest['consumed'] + manifest['cited_only']:\n              data = pathlib.Path(entry['path']).read_bytes()\n              framed = b'blob ' + str(len(data)).encode() + b'\\0' + data\n              if len(data) != entry['bytes'] or hashlib.sha256(data).hexdigest() != entry['sha256'] or hashlib.sha1(framed).hexdigest() != entry['git_blob']:\n                  raise ValueError('merged source drifted: ' + entry['path'])\n          # the consumed unmerged dependency (#191) is verified by its pinned blob: from the tree if the dependency\n          # has landed (then it must be byte-identical to the pinned version, else this packet needs rebinding),\n          # otherwise fetched by blob id through the repository API; absence or drift fails the job\n          for entry in manifest.get('consumed_unmerged', []):\n              tree_path = pathlib.Path(entry['path'])\n              if tree_path.exists():\n                  data = tree_path.read_bytes()\n                  where = 'tree'\n              else:\n                  req = urllib.request.Request(\n                      'https://api.github.com/repos/' + os.environ['GH_REPOSITORY'] + '/git/blobs/' + entry['git_blob'],\n                      headers={'Authorization': 'Bearer ' + os.environ['GH_TOKEN'], 'Accept': 'application/vnd.github+json'})\n                  with urllib.request.urlopen(req, timeout=60) as resp:\n                      blob = json.load(resp)\n                  if blob.get('encoding') != 'base64':\n                      raise ValueError('unexpected blob encoding for ' + entry['path'])\n                  data = base64.b64decode(blob['content'])\n                  where = 'blob api'\n              framed = b'blob ' + str(len(data)).encode() + b'\\0' + data\n              if len(data) != entry['bytes'] or hashlib.sha256(data).hexdigest() != entry['sha256'] or hashlib.sha1(framed).hexdigest() != entry['git_blob']:\n                  raise ValueError('consumed unmerged dependency differs from the pinned blob (rebind required): ' + entry['path'] + ' via ' + where)\n              print(json.dumps({'consumed_unmerged_verified': entry['path'], 'git_blob': entry['git_blob'], 'via': where}))\n          script = str(root / 'rate_ledger_check.py')\n          expected = (root / 'RESULTS.json').read_bytes()\n          for flags in (['-B', '-S'], ['-B', '-O', '-S']):\n              out = subprocess.run([sys.executable, *flags, script], check=True, capture_output=True, timeout=600).stdout\n              if out != expected:\n                  raise RuntimeError('output differs from RESULTS.json under ' + ' '.join(flags))\n              for m in manifest['mutants']:\n                  rc = subprocess.run([sys.executable, *flags, script, '--mutant', m], capture_output=True, timeout=600).returncode\n                  if rc != 1:\n                      raise RuntimeError('mutant ' + m + ' not rejected')\n              rc = subprocess.run([sys.executable, *flags, script, '--mutant', 'M9'], capture_output=True, timeout=600).returncode\n              if rc != 2:\n                  raise RuntimeError('unknown mutant label not rejected with exit 2')\n          print(json.dumps({'scientific_effect': 'NONE', 'mathematical_acceptance': False}))\n          PY\n          git diff --exit-code\n"

