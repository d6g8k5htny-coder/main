+test('required routes order targets by length then ID and break parallel-edge ties by relation',()=>{
+ const open={kind:'candidate',classification:'OPEN_ACTIVE'},late={from:'R',to:'b',required:true,relation:'zeta'},early={from:'R',to:'b',required:true,relation:'alpha'};
+ const g={nodes:{R:{...open},a:{...open},b:{...open}},edges:[late,early,{from:'b',to:'a',required:true,relation:'deeper'}]};
+ const routes=m.requiredDependencyPaths(g,'R');
+ assert.deepEqual(routes.map(r=>r.ids),[['R','b'],['R','b','a']],'A shorter route precedes a longer route whose target ID sorts first');
+ assert.equal(routes[0].edges[0],early,'Parallel required edges resolve by relation, not source order');assert.equal(routes[1].edges[0],early);
+ const segments=m.requiredDependencyWindow(m.requiredDependencyAnalysis(g,'R')).segments;
+ assert.deepEqual(segments.map(s=>s.target),['b','a']);assert.equal(segments[0].incomingEdges[1],early);
+});
+
+test('route windows never emit empty boundary segments and clamp explicit limits to the render ceiling',()=>{
+ const nodes={R:{kind:'candidate',classification:'OPEN_ACTIVE'}},edges=[];
+ for(let i=0;i<200;i++){const id='t'+String(i).padStart(3,'0');nodes[id]={kind:'candidate',classification:'OPEN_ACTIVE'};edges.push({from:'R',to:id,required:true,relation:'star'});}
+ const g={nodes,edges},a=m.requiredDependencyAnalysis(g,'R');assert.equal(a.totalOccurrences,400);
+ for(let page=1;page<=200;page++){const w=m.requiredDependencyWindow(a,{page,limit:2});assert.equal(w.segments.length,1);assert.ok(w.segments.every(s=>s.ids.length>0),'Page '+page+' starts on a route boundary yet emitted an empty segment');}
+ const wide=m.requiredDependencyWindow(a,{limit:1000});assert.equal(wide.limit,150);assert.equal(wide.occurrences,150);assert.equal(wide.pages,3);
+ const rows=m.directRelationWindow(g,'R','outgoing',{limit:1000});assert.equal(rows.limit,150);assert.equal(rows.rows.length,150);assert.equal(rows.omitted,50);
+});
