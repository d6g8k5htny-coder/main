def UniversalLaw.Spec.Side24.DerivativeBoundAtLeastOne : Prop :=
∀ (d q : ℕ),
  q ≤ 6 →
    ∀ (x : UniversalLaw.Spec.Side24.E d),
      1 ≤ ‖x‖ →
        ∀ (u : Fin q → UniversalLaw.Spec.Side24.E d),
          UniversalLaw.Spec.Side24.IsUnitTuple d q u →
            |(iteratedFDeriv ℝ q (UniversalLaw.Spec.Side24.Kinf d) x) u| ≤ 76 * ‖x‖ ^ 6 * Real.exp (-‖x‖ ^ 2 / 2)
def UniversalLaw.Spec.Side24.DerivativePairingBound : Prop :=
∀ (d q : ℕ),
  q ≤ 6 →
    ∀ (x : UniversalLaw.Spec.Side24.E d) (u : Fin q → UniversalLaw.Spec.Side24.E d),
      UniversalLaw.Spec.Side24.IsUnitTuple d q u →
        |(iteratedFDeriv ℝ q (UniversalLaw.Spec.Side24.Kinf d) x) u| ≤
          Real.exp (-‖x‖ ^ 2 / 2) * UniversalLaw.Spec.Side24.pairingSum q ‖x‖
def UniversalLaw.Spec.Side24.IsUnitTuple : (d q : ℕ) → (Fin q → UniversalLaw.Spec.Side24.E d) → Prop :=
fun d q u => ∀ (i : Fin q), ‖u i‖ = 1
def UniversalLaw.Spec.Side24.Kinf : (d : ℕ) → UniversalLaw.Spec.Side24.E d → ℝ :=
fun d z => Real.exp (-‖z‖ ^ 2 / 2)
def UniversalLaw.Spec.Side24.pairingSum : ℕ → ℝ → ℝ :=
fun q r =>
  ∑ j ∈ Finset.range (q / 2 + 1), ↑q.factorial * r ^ (q - 2 * j) / (2 ^ j * ↑j.factorial * ↑(q - 2 * j).factorial)
@[reducible] def UniversalLaw.Spec.Side24.E : ℕ → Type :=
fun d => EuclideanSpace ℝ (Fin d)
