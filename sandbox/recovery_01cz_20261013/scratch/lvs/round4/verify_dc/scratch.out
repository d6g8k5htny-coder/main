UniversalLaw.Proofs.Side24Analysis.densityComparison : UniversalLaw.Spec.Side24.DensityComparison
def UniversalLaw.Spec.Side24.DensityComparison : Prop :=
∀ (m : ℕ)
  (C0 C : Matrix (Fin (UniversalLaw.Spec.Side24.symCoordDim m)) (Fin (UniversalLaw.Spec.Side24.symCoordDim m)) ℝ),
  C0.PosDef →
    C.PosDef →
      (C - (1 - UniversalLaw.Spec.Side24.epsilon) • C0).PosSemidef →
        ((1 + UniversalLaw.Spec.Side24.epsilon) • C0 - C).PosSemidef →
          ∀ (x : Fin (UniversalLaw.Spec.Side24.symCoordDim m) → ℝ),
            ((1 - UniversalLaw.Spec.Side24.epsilon) / (1 + UniversalLaw.Spec.Side24.epsilon)) ^
                    (↑(UniversalLaw.Spec.Side24.symCoordDim m) / 2) *
                  UniversalLaw.Spec.Side24.gaussDensity (UniversalLaw.Spec.Side24.symCoordDim m)
                    ((1 - UniversalLaw.Spec.Side24.epsilon) • C0) x ≤
                UniversalLaw.Spec.Side24.gaussDensity (UniversalLaw.Spec.Side24.symCoordDim m) C x ∧
              UniversalLaw.Spec.Side24.gaussDensity (UniversalLaw.Spec.Side24.symCoordDim m) C x ≤
                ((1 + UniversalLaw.Spec.Side24.epsilon) / (1 - UniversalLaw.Spec.Side24.epsilon)) ^
                    (↑(UniversalLaw.Spec.Side24.symCoordDim m) / 2) *
                  UniversalLaw.Spec.Side24.gaussDensity (UniversalLaw.Spec.Side24.symCoordDim m)
                    ((1 + UniversalLaw.Spec.Side24.epsilon) • C0) x
