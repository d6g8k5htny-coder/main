UniversalLaw.Proofs.Side24Interfaces.rayleighSquareLaw : ∀ (I : UniversalLaw.Spec.Side24.ConeMomentInterface),
  UniversalLaw.Spec.Side24.RayleighSquareLaw I
def UniversalLaw.Spec.Side24.RayleighSquareLaw : UniversalLaw.Spec.Side24.ConeMomentInterface → Prop :=
fun I => ∀ (a : ℝ), 0 ≤ a → (I.P {ω | I.x ω ^ 2 + I.y ω ^ 2 ≤ a}).toReal = ∫ (z : ℝ) in 0..a, Real.exp (-z / 2) / 2
structure UniversalLaw.Spec.Side24.ConeMomentInterface : Type 1
number of parameters: 0
fields:
  UniversalLaw.Spec.Side24.ConeMomentInterface.Ω : Type
  UniversalLaw.Spec.Side24.ConeMomentInterface.mΩ : MeasurableSpace self.Ω
  UniversalLaw.Spec.Side24.ConeMomentInterface.P : MeasureTheory.Measure self.Ω
  UniversalLaw.Spec.Side24.ConeMomentInterface.isProb : MeasureTheory.IsProbabilityMeasure self.P
  UniversalLaw.Spec.Side24.ConeMomentInterface.A : self.Ω → ℝ
  UniversalLaw.Spec.Side24.ConeMomentInterface.A_law : MeasureTheory.Measure.map self.A self.P =
      ProbabilityTheory.gaussianReal 0 (8 / 3)
  UniversalLaw.Spec.Side24.ConeMomentInterface.s : self.Ω → ℝ
  UniversalLaw.Spec.Side24.ConeMomentInterface.x : self.Ω → ℝ
  UniversalLaw.Spec.Side24.ConeMomentInterface.y : self.Ω → ℝ
  UniversalLaw.Spec.Side24.ConeMomentInterface.sxy_law : MeasureTheory.Measure.map
        (fun ω => (self.s ω, self.x ω, self.y ω)) self.P =
      (ProbabilityTheory.gaussianReal 0 (5 / 3)).prod
        ((ProbabilityTheory.gaussianReal 0 1).prod (ProbabilityTheory.gaussianReal 0 1))
constructor:
  UniversalLaw.Spec.Side24.ConeMomentInterface.mk (Ω : Type) [mΩ : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω)
    [isProb : MeasureTheory.IsProbabilityMeasure P] (A : Ω → ℝ)
    (A_law : MeasureTheory.Measure.map A P = ProbabilityTheory.gaussianReal 0 (8 / 3)) (s x y : Ω → ℝ)
    (sxy_law :
      MeasureTheory.Measure.map (fun ω => (s ω, x ω, y ω)) P =
        (ProbabilityTheory.gaussianReal 0 (5 / 3)).prod
          ((ProbabilityTheory.gaussianReal 0 1).prod (ProbabilityTheory.gaussianReal 0 1))) :
    UniversalLaw.Spec.Side24.ConeMomentInterface
