UniversalLaw.Proofs.Side24Analysis.latticeImageSumBound : UniversalLaw.Spec.Side24.LatticeImageSumBound
def UniversalLaw.Spec.Side24.LatticeImageSumBound : Prop :=
∀ d ≤ 3,
  (Summable fun n => UniversalLaw.Spec.Side24.imageTerm d n) ∧
    ∑' (n : Fin d → ℤ), UniversalLaw.Spec.Side24.imageTerm d n ≤ 1458 * Real.exp (-288)
def UniversalLaw.Spec.Side24.imageTerm : (d : ℕ) → (Fin d → ℤ) → ℝ :=
fun d n =>
  if n = 0 then 0
  else UniversalLaw.Spec.Side24.intNormSq d n ^ 3 * Real.exp (-288 * UniversalLaw.Spec.Side24.intNormSq d n)
def UniversalLaw.Spec.Side24.intNormSq : (d : ℕ) → (Fin d → ℤ) → ℝ :=
fun d n => ∑ i, ↑(n i) ^ 2
