def UniversalLaw.Spec.Side24.ReferenceOddAndPinBlocks : Prop :=
∀ (d : ℕ),
  d = 2 ∨ d = 3 →
    ∀ (hd : 0 < d) (R : Fin d → UniversalLaw.Spec.Side24.E d),
      Orthonormal ℝ R →
        UniversalLaw.Spec.Side24.gradCov d (UniversalLaw.Spec.Side24.Kinf d) R = 1 ∧
          UniversalLaw.Spec.Side24.thirdVar d (UniversalLaw.Spec.Side24.Kinf d) (R ⟨0, hd⟩) = 15 ∧
            (UniversalLaw.Spec.Side24.thirdGradCov d (UniversalLaw.Spec.Side24.Kinf d) (R ⟨0, hd⟩) R = fun j =>
                if j = ⟨0, hd⟩ then -3 else 0) ∧
              (UniversalLaw.Spec.Side24.pinCov d (UniversalLaw.Spec.Side24.Kinf d) (R ⟨0, hd⟩) R =
                  Matrix.diagonal fun i => if i = ⟨0, hd⟩ then 3 else 1) ∧
                UniversalLaw.Spec.Side24.condThirdVariance d (UniversalLaw.Spec.Side24.Kinf d) (R ⟨0, hd⟩) R = 6
UniversalLaw.Proofs.Side24Analysis.referenceOddAndPinBlocks : UniversalLaw.Spec.Side24.ReferenceOddAndPinBlocks
theorem UniversalLaw.Proofs.Side24Analysis.referenceOddAndPinBlocks : UniversalLaw.Spec.Side24.ReferenceOddAndPinBlocks :=
fun d a hd R hR =>
  ⟨UniversalLaw.Proofs.Side24Analysis.Aux.rb_gradCov R hR,
    ⟨UniversalLaw.Proofs.Side24Analysis.Aux.rb_thirdVar hd R hR,
      ⟨UniversalLaw.Proofs.Side24Analysis.Aux.rb_thirdGradCov hd R hR,
        ⟨UniversalLaw.Proofs.Side24Analysis.Aux.rb_pinCov hd R hR,
          UniversalLaw.Proofs.Side24Analysis.Aux.rb_condThirdVariance hd R hR⟩⟩⟩⟩
