UniversalLaw.Proofs.Side24Analysis.referencePinDensityProduct : UniversalLaw.Spec.Side24.ReferencePinDensityProduct
def UniversalLaw.Spec.Side24.ReferencePinDensityProduct : Prop :=
∀ (d : ℕ),
  d = 2 ∨ d = 3 →
    ∀ (hd : 0 < d) (R : Fin d → UniversalLaw.Spec.Side24.E d),
      Orthonormal ℝ R →
        UniversalLaw.Spec.Side24.gaussDensity d (UniversalLaw.Spec.Side24.gradCov d (UniversalLaw.Spec.Side24.Kinf d) R)
              0 *
            UniversalLaw.Spec.Side24.gaussDensity d
              (UniversalLaw.Spec.Side24.pinCov d (UniversalLaw.Spec.Side24.Kinf d) (R ⟨0, hd⟩) R) 0 =
          (2 * Real.pi) ^ (-↑d) / √3
